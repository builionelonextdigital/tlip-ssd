<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mysign_config_company_rule" model="ir.rule">
        <field name="name">MySign Config multi-company</field>
        <field name="model_id" ref="model_mysign_config"/>
        <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
    </record>

    <record id="mysign_account_company_rule" model="ir.rule">
        <field name="name">MySign Account multi-company</field>
        <field name="model_id" ref="model_mysign_account"/>
        <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
    </record>
</odoo>
