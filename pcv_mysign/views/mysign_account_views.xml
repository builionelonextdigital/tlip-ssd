<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_mysign_account_form" model="ir.ui.view">
        <field name="name">mysign.account.form</field>
        <field name="model">mysign.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Login" name="action_login" type="object" class="btn-primary"
                        invisible="state == 'connected'"/>
                    <button string="Check Token" name="action_check_token" type="object"
                        invisible="state != 'connected'"/>
                    <button string="Disconnect" name="disconnect" type="object"
                        invisible="state != 'connected'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="idle,connected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1><field name="code" placeholder="Account Code"/></h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="config_id"
                                options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Token Info">
                            <field name="token_type"/>
                            <field name="expires_in"/>
                            <field name="token_expiry"/>
                            <field name="last_authenticated_datetime"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_mysign_account_list" model="ir.ui.view">
        <field name="name">mysign.account.list</field>
        <field name="model">mysign.account</field>
        <field name="arch" type="xml">
            <list string="MySign Accounts">
                <field name="code"/>
                <field name="company_id"/>
                <field name="config_id"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'connected'"
                    decoration-warning="state == 'idle'"/>
                <field name="token_expiry"/>
                <field name="last_authenticated_datetime"/>
            </list>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_mysign_account" model="ir.actions.act_window">
        <field name="name">MySign Accounts</field>
        <field name="res_model">mysign.account</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
