<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account_report_filter_currency.AccountReportCurrencyFilters">
        <Dropdown 
            menuClass="'account_report_filter_currency'"
        >
            <button class="btn btn-secondary">
                <i class="fa fa-usd me-1"/>Currency
            </button>

            <t t-set-slot="content">
                <div class="dropdown-item gap-2 align-items-center">
                    <label>Currency</label>
                    <RecordSelector t-props="getValueRecordSelectorProps('res.currency', 'currency_id')"/>
                </div>
            </t>

        </Dropdown>
    </t>
</templates>
 