<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-inherit="account_reports.AccountReportFiltersCustomizable"
        t-inherit-mode="extension">
        <xpath expr="//div[@id='filter_extra_options']" position="before">
            <!-- Currency filter -->
            <t t-if="'filter_currency' in controller.options">
                <div id="filter_currency">
                    <t t-call="account_report_filter_currency.AccountReportCurrencyFilters" />
                </div>
            </t>
        </xpath>
    </t>
</templates>