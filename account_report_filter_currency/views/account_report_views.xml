<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="account_report_filter_currency_form_view" model="ir.ui.view">
            <field name="name">account.report.form.filter.currency</field>
            <field name="model">account.report</field>
            <field name="priority">10</field>
            <field name="inherit_id" ref="account_reports.account_report_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='filter_account_type']" position="after">
                    <field name="filter_currency"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>