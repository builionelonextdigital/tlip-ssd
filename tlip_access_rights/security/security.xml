<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_tlip_roles">
            <field name="name">TLIP Roles</field>
            <field name="sequence">100</field>
        </record>

        <!-- Procurement -->
        <record model="ir.module.category" id="module_category_tlip_procurement">
            <field name="name">Procurement</field>
            <field name="parent_id" ref="module_tlip_roles"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_tlip_procurement_user" model="res.groups">
            <field name="name">Procurement User</field>
            <field name="category_id" ref="tlip_access_rights.module_category_tlip_procurement"/>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user')), (4, ref('base.group_user'))]"/>
        </record>

        <record id="group_tlip_procurement_manager" model="res.groups">
            <field name="name">Procurement Manager</field>
            <field name="category_id" ref="tlip_access_rights.module_category_tlip_procurement"/>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_manager')), (4, ref('tlip_access_rights.group_tlip_procurement_user'))]"/>
        </record>

        <!-- Accounting -->
        <record model="ir.module.category" id="module_category_tlip_accounting">
            <field name="name">Accounting</field>
            <field name="parent_id" ref="module_tlip_roles"/>
            <field name="sequence">20</field>
        </record>
        
        <record id="group_tlip_accountant" model="res.groups">
            <field name="name">Accountant</field>
            <field name="category_id" ref="tlip_access_rights.module_category_tlip_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <record id="group_tlip_chief_account_assistant" model="res.groups">
            <field name="name">Chief Accountant's Assistant</field>
            <field name="category_id" ref="tlip_access_rights.module_category_tlip_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_manager'))]"/>
        </record>        

        <record id="group_tlip_chief_account" model="res.groups">
            <field name="name">Chief Account</field>
            <field name="category_id" ref="tlip_access_rights.module_category_tlip_accounting"/>
            <field name="implied_ids" eval="[(4, ref('tlip_access_rights.group_tlip_chief_account_assistant'))]"/>
        </record>

        <!-- Leasing -->
        <record model="ir.module.category" id="module_category_tlip_leasing">
            <field name="name">Leasing</field>
            <field name="parent_id" ref="module_tlip_roles"/>
            <field name="sequence">30</field>
        </record>

        <record id="group_tlip_leasing_user" model="res.groups">
            <field name="name">Leasing User</field>
            <field name="category_id" ref="tlip_access_rights.module_category_tlip_leasing"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="group_tlip_leasing_manager" model="res.groups">
            <field name="name">Leasing Manager</field>
            <field name="category_id" ref="tlip_access_rights.module_category_tlip_leasing"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('tlip_access_rights.group_tlip_leasing_user'))]"/>
        </record>

        <!-- System / General -->
        <record model="ir.module.category" id="module_category_tlip_system">
            <field name="name">System</field>
            <field name="parent_id" ref="module_tlip_roles"/>
            <field name="sequence">90</field>
        </record>

        <record id="group_tlip_allow_multi_company" model="res.groups">
            <field name="name">Allow Multi-Company Switch</field>
            <field name="category_id" ref="tlip_access_rights.module_category_tlip_system"/>
            <field name="comment">
                Allow user to switch between multiple companies in the top bar.
            </field>
        </record>
    </data>
</odoo>
