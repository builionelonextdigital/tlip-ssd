<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.rule" id="leasing_quotation_user_rule">
            <field name="name">Leasing Quotation User Rule</field>
            <field name="model_id" ref="tlip_leasing.model_leasing_quotation" />
            <field name="groups" eval="[(4, ref('tlip_access_rights.group_tlip_leasing_user'))]" />
            <field name="domain_force">[('user_id','=',user.id)]</field>
        </record>

        <record model="ir.rule" id="leasing_quotation_manager_rule">
            <field name="name">Leasing Quotation Manager Rule</field>
            <field name="model_id" ref="tlip_leasing.model_leasing_quotation" />
            <field name="groups" eval="[(4, ref('tlip_access_rights.group_tlip_leasing_manager'))]" />
            <field name="domain_force">[(1,'=',1)]</field>
        </record>
    </data>
</odoo>