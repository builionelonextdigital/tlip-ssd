<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_view_form_sign" model="ir.ui.view">
        <field name="name">res_company.view.form.sign</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <field name="website" position="after">
                <field name="e_signature_file" widget="binary" filename="e_signature_filename"
                    options="{'accepted_file_extensions': 'image/jpeg, image/png', 'number_of_files': 1}" />
                <field name="e_signature_filename" invisible="1" />
            </field>
        </field>
    </record>
</odoo>
