<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sign_ticket_form_inherit" model="ir.ui.view">
        <field name="name">sign.ticket.form.inherit.tlip</field>
        <field name="model">sign.ticket</field>
        <field name="inherit_id" ref="pcv_sign_ticket.view_sign_ticket_form"/>
        <field name="arch" type="xml">
            <div class="oe_title" position="before">
                <div name="button_box" class="oe_button_box">
                    <button class="oe_stat_button"
                        name="action_open_approval_history_ids"
                        type="object"
                        invisible="history_approvals_count == 0"
                        icon="fa-history">
                        <div class="o_stat_info">
                            <span class="o_stat_value">
                                <field name="history_approvals_count"/>
                            </span>
                            <span class="o_stat_text">Approval Requests</span>
                        </div>
                    </button>
                </div>
            </div>

            <field name="signing_type" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <button name="action_submit" position="after">
                <button name="action_submit_approval"
                    string="Submit"
                    type="object"
                    class="btn-primary"
                    confirm="Are you sure that you want to do this action?"
                    invisible="state != 'draft' or approval_state != 'draft'"/>
            </button>
            <button name="action_submit" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>

            <button name="action_withdraw" position="after">
                <button name="action_withdraw_approval"
                    string="Withdraw"
                    type="object"
                    confirm="Are you sure that you want to do this action?"
                    invisible="user_status != 'pending'"/>
            </button>
            <button name="action_withdraw" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>

            <button name="action_approve" position="attributes">
                <attribute name="invisible">user_status != 'pending'</attribute>
            </button>

            <button name="action_reject" position="attributes">
                <attribute name="invisible">user_status != 'pending'</attribute>
                <attribute name="confirm">Are you sure that you want to do this action?</attribute>
            </button>

            <button name="action_cancel" position="attributes">
                <attribute name="invisible">state != 'draft'</attribute>
                <attribute name="confirm">Are you sure that you want to do this action?</attribute>
            </button>


            <xpath expr="//field[@name='signer_line_ids']//field[@name='user_id']" position="after">
                <field name="job_id" />
            </xpath>

            <xpath expr="//field[@name='signer_line_ids']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <xpath expr="//field[@name='sign_document_ids']//list" position="inside">
                <field name="is_pdf" column_invisible="1"/>
                <button name="action_preview"
                    type="object" icon="fa-eye" class="btn"
                    invisible="not file or not is_pdf" />
            </xpath>

        </field>
    </record>

</odoo>
