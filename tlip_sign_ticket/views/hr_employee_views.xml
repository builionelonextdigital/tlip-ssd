<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='coach_id']" position="after">
                <field name="e_signature_file" widget="binary" filename="e_signature_filename"
                    options="{'accepted_file_extensions': 'image/jpeg, image/png', 'number_of_files': 1}"/>
                <field name="e_signature_filename" invisible="1"/>
                <field name="initial_signature_file" widget="binary" filename="initial_signature_filename"
                    options="{'accepted_file_extensions': 'image/jpeg, image/png', 'number_of_files': 1}"/>
                <field name="initial_signature_filename" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
