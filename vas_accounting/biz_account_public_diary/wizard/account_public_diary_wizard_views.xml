<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_public_diary_wizard_form" model="ir.ui.view">
            <field name="name">account.public.diary.wizard.form</field>
            <field name="model">account.public.diary.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="from_date" required="1"/>
                        </group>
                        <group>
                            <field name="to_date" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="S03a-DN(XLSX)" name="export_file" type="object" class="oe_highlight" context="{'file_generator': 'export_to_s03a_dn_xlsx'}"/>
                        <button string="S03a-DN(PDF)" name="export_file" type="object" class="oe_highlight" context="{'file_generator': 'export_to_s03a_dn_pdf'}"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="account_public_diary_wizard_action" model="ir.actions.act_window">
            <field name="name">Public Diary</field>
            <field name="res_model">account.public.diary.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_action_account_public_diary_wizard"
                  name="Account Public Diary"
                  action="account_public_diary_wizard_action"
                  parent="account_reports.account_reports_audit_reports_menu"
        />
    </data>
</odoo>
