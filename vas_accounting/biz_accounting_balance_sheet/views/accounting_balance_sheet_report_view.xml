<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_accounting_balance_sheet_report_tree" model="ir.ui.view">
            <field name="name">accounting.balance.sheet.report.tree</field>
            <field name="model">accounting.balance.sheet.report</field>
            <field name="arch" type="xml">
                <list>
                    <field name="previous_id"/>
                    <field name="from_date"/>
                    <field name="to_date"/>
                    <field name="template_id"/>
                    <field name="state"/>
                </list></field>
        </record>
        <record id="view_accounting_balance_sheet_report_form" model="ir.ui.view">
            <field name="name">accounting.balance.sheet.report.form</field>
            <field name="model">accounting.balance.sheet.report</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button class="btn-primary" name="action_calculate" string="Calculate" type="object"/>
                        <button invisible="state not in ['draft']" name="action_closed" string="Closing" type="object"/>
                        <button invisible="state not in ['closed']" name="action_open" string="Open" type="object"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-bars" name="action_view_detail" string="Detail" type="object"/>
                        </div>
                        <group>
                            <group>
                                <field name="previous_id" readonly="state == 'closed'"/>
                                <field name="from_date" readonly="state == 'closed'"/>
                                <field name="to_date" readonly="state == 'closed'"/>
                                <field name="template_id" readonly="state == 'closed'"/>
                            </group>
                        </group>
                        <group>
                            <field colspan="2" name="line_ids" nolabel="1" readonly="state == 'closed'">
                                <list default_order="code" editable="bottom">
                                    <field name="balance_id"/>
                                    <field name="code"/>
                                    <field name="number_last_year"/>
                                    <field name="number_first_year"/>
                                    <field invisible="1" name="apply_by"/>
                                    <button class="btn-primary" invisible="apply_by == 'total_categ'" name="view_move_line" string="View detail" type="object"/>
                                </list></field>
                        </group>
                    </sheet>
                    <chatter />
                </form></field>
        </record>
        <record id="action_accounting_balance_sheet_report" model="ir.actions.act_window">
            <field name="name">Accounting balance sheet</field>
            <field name="res_model">accounting.balance.sheet.report</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="view_accounting_balance_sheet_report_line_tree" model="ir.ui.view">
            <field name="name">accounting.balance.sheet.report.line.tree</field>
            <field name="model">accounting.balance.sheet.report.line</field>
            <field name="arch" type="xml">
                <list>
                    <field name="balance_id"/>
                    <field name="code"/>
                    <field name="number_first_year"/>
                    <field name="number_last_year"/>
                    <field invisible="1" name="apply_by"/>
                    <button class="btn-primary" invisible="apply_by == 'total_categ'" name="view_move_line" string="View detail" type="object"/>
                </list></field>
        </record>
        <record id="view_accounting_balance_sheet_report_line_search" model="ir.ui.view">
            <field name="name">accounting.balance.sheet.report.line.search</field>
            <field name="model">accounting.balance.sheet.report.line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="balance_id"/>
                    <field name="code"/>
                </search></field>
        </record>
        <record id="action_accounting_balance_sheet_report_line" model="ir.actions.act_window">
            <field name="name">Accounting balance sheet detail</field>
            <field name="res_model">accounting.balance.sheet.report.line</field>
            <field name="view_mode">list</field>
        </record>
    </data>
</odoo>
