<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_balance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.balance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="fiscalyear" position="after">
                <setting id="business_cycle">
                    <field name="business_cycle"/>
                </setting>
            </setting>
            <xpath expr="//block[@name='fiscal_localization_setting_container']//div[@class='content-group']" position="after">
                <div class="content-group">
                    <div class="row mt16">
                        <button name="update_accounting_balance_sheet" string="Update Data accounting balance sheet" type="object"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>