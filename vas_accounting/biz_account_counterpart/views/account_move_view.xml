<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Journal Entries -->
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_post']" position="before">
                    <button groups="account.group_account_user" invisible="countered_status == 'none'" name="action_delete_counterpart" string="Remove Counterparts" type="object"/>
                    <button class="oe_highlight" groups="account.group_account_user" invisible="countered_status == 'fully'" name="action_smart_create_counterpart" string="Create Counterparts" type="object">
                    </button>
                </xpath>
                <xpath expr="//page[last()]" position="after">
                    <page groups="account.group_account_user" id="counterparts" string="Counterparts Mapping">
                        <group>
                            <group>
                                <field name="countered_status"/>
                            </group>
                        </group>
                        <div id="ctp_ids">
                            <label for="ctp_ids"/>
                            <field name="ctp_ids"><list editable="bottom" id="dr_ctp_ids">
                                    <field name="dr_aml_id"/>
                                    <field name="dr_aml_debit"/>
                                    <field name="cr_aml_id"/>
                                    <field name="cr_aml_credit"/>
                                    <field name="countered_amt"/>
                                    <field name="countered_amt_currency"/>
                                    <field invisible="1" name="company_currency_id"/>
                                </list></field>
                        </div>
                    </page>
                </xpath></field>
        </record>
        <record id="view_account_move_filter" model="ir.ui.view">
            <field name="name">account.move.select</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_move_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="after">
                    <filter domain="[('countered_status', '=', 'none')]" help="Show Journal entries that have no counterpart" name="not_countered" string="Not Countered"/>
                    <filter domain="[('countered_status', '=', 'partially')]" help="Show Journal entries that have counterpart(s) but not fully countered yet" name="partially_countered" string="Partially Countered"/>
                    <filter domain="[('countered_status', '=', 'fully')]" help="Show Journal entries that have fully countered" name="fully_countered" string="Fully Countered"/>
                    <separator/>
                </xpath></field>
        </record>
        <record id="action_server_delete_counterparts" model="ir.actions.server">
            <field name="name">Delete Counterparts</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="binding_model_id" ref="model_account_move"/>
            <field name="state">code</field>
            <field name="code">records.action_delete_counterpart()</field>
        </record>
        <record id="action_server_create_counterparts" model="ir.actions.server">
            <field name="name">Generate Counterparts</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="binding_model_id" ref="model_account_move"/>
            <field name="state">code</field>
            <field name="code">records.action_smart_create_counterpart()</field>
        </record>
    </data>
</odoo>
