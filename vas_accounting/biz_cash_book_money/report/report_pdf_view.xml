<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    	<template id="rp_cash_book_pdf">
		    <t t-call="web.html_container">
		        <t t-call="web.basic_layout">
			    	<t t-set="company" t-value="doc.env.company"/>
			        <div class="page" style="font-family: Times New Roman;font-size:18px">
			        	<div class="row">
			        		<div class="col-6">
			        			<p><b>Đơn vị: <span t-esc="company.name"/></b></p>
			        			<p><b>Địa chỉ: <span t-esc="get_user_company_address"/></b></p>
			        		</div>
			        		<div class="col-6 text-center">
			        			<p style="font-size: 20px"><b>Mẫu số S07-DN</b></p>
			        			<p>(Ban hành theo Thông tư số 200/2014/TT-BTC</p>
			        			<p>Ngày 22/12/2014 của Bộ Tài chính)</p>
			        		</div>
			        	</div>
			        	<div class="mt-3 text-center">
			        		<h4 class="bold">SỔ QUỸ TIỀN MẶT</h4>
			        		<p class="bold" style="font-size: 20px;margin-bottom: 10px;">Loại quỹ: <span t-esc="account_type"/></p>
			        	</div>
				        <table >
				        	<thead>
				        		<tr style="line-height: 22px;">
				        			<th rowspan="2">Ngày, tháng ghi sổ</th>
				        			<th rowspan="2">Ngày, tháng chứng từ</th>
				        			<th colspan="2">Số hiệu chứng từ</th>
				        			<th rowspan="2">Diễn giải</th>
				        			<th colspan="3">Số tiền</th>
				        			<th class="nowrap" rowspan="2">Ghi chú</th>
				        		</tr>
				        		<tr>
				        			<th>Thu</th>
				        			<th>Chi</th>
				        			<th>Thu</th>
				        			<th>Chi</th>
				        			<th>Tồn</th>
				        		</tr>
				        		<tr>
				        			<th>A</th>
				        			<th>B</th>
				        			<th></th>
				        			<th></th>
				        			<th>E</th>
				        			<th>1</th>
				        			<th>2</th>
				        			<th>3</th>
				        			<th>G</th>
				        		</tr>
				        	</thead>
				        	<tbody>
				        		<t t-foreach="lines" t-as="index">
				        			<t t-set="line" t-value="lines[index]"/>
				        			<tr class="bold" t-if="line['is_bold']">
					        			<td colspan="4"><span t-esc="line['a']"/></td>
					        			<td class="nowrap"><span t-esc="line['e']"/></td>
					        			<td class="nowrap text-right"><span t-esc="line['f']"/></td>
					        			<td class="nowrap text-right"><span t-esc="line['g']"/></td>
					        			<td class="nowrap text-right"><span t-esc="line['h']"/></td>
					        			<td class="text-right"><span t-esc="line['i']"/></td>
					        		</tr>
					        		<tr t-else="">
					        			<td><span t-esc="line['a']"/></td>
					        			<td><span t-esc="line['b']"/></td>
					        			<td><span t-esc="line['c']"/></td>
					        			<td><span t-esc="line['d']"/></td>
					        			<td><span t-esc="line['e']"/></td>
					        			<td class="nowrap text-right"><span t-esc="line['f']"/></td>
					        			<td class="nowrap text-right"><span t-esc="line['g']"/></td>
					        			<td class="nowrap text-right"><span t-esc="line['h']"/></td>
					        			<td class="text-right"><span t-esc="line['i']"/></td>
					        		</tr>
				        		</t>
				        	</tbody>
				        </table>
				        <div class="bold mt-3" >
				        	<p>- Sổ này có ... trang, đánh số từ trang 01 đến trang ...</p>
				        	<p>- Ngày mở sổ ...</p>
				        </div>
				        <div class="row text-center" >
				        	<div class="col-4">
				        		<br/>
				        		<p class="bold">Người ghi sổ</p>
				        		<p style="font-style: italic">(Ký, họ tên)</p>
				        	</div>
				        	<div class="col-4">
				        		<br/>
				        		<p class="bold">Kế toán trưởng</p>
				        		<p style="font-style: italic">(Ký, họ tên)</p>
				        	</div>
				        	<div class="col-4">
				        		<p style="font-style: italic">Ngày...tháng...năm...</p>
				        		<p class="bold">Giám đốc</p>
				        		<p style="font-style: italic">(Ký, họ tên, đóng dấu)</p>
				        	</div>
				        </div>
				        <div class="footer" style="font-family: Times New Roman;">
			                <div class="text-right" style="text-align: right">
			                    <div class="text-muted">
			                        Trang: <span class="page"/> / <span class="topage"/>
			                    </div>
			                </div>
			            </div>
			        </div>
			        <style>
			        	p {
			        		margin: 0;
			        	}
			        	.bold{
			        		font-weight: bold;
			        	}
			        	.text-right {
			        		text-align: right;
			        	}
			        	.nowrap{
			        		white-space: nowrap;
			        	}
			        	table{
			        		width: 100%;
			        	}
			        	thead{
			        		text-align: center;
			        	}
			        	td, th{
			        		padding: 5px;
			        		vertical-align: middle;
			        	}
			        	tr, td, th{
			        		page-break-inside: avoid;
			        		border: 1px  solid;

			        	}
			        </style>
			    </t>
		    </t>
		</template>

		<record id="paperformat_rp_cash_book_a4" model="report.paperformat">
            <field name="name">Cash book account</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">7</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

		<record id="action_print_cash_book_pdf" model="ir.actions.report">
	        <field name="name">Cash book</field>
	        <field name="model">cash.book</field>
	        <field name="report_type">qweb-pdf</field>
	        <field name="report_name">biz_cash_book_money.rp_cash_book_pdf</field>
	        <field name="report_file">biz_cash_book_money.rp_cash_book_pdf</field>
	        <field name="paperformat_id" ref="paperformat_rp_cash_book_a4"/>
	        <field name="binding_type">report</field>
	    </record>
    </data>
</odoo>