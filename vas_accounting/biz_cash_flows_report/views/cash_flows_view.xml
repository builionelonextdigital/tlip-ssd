<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_cash_flows_tree" model="ir.ui.view">
            <field name="name">cash.flows.tree</field>
            <field name="model">cash.flows</field>
            <field name="arch" type="xml">
                <list>
                    <field name="categ_name"/>
                    <field name="code"/>
                    <field name="parent_level"/>
                    <field name="apply_by"/>
                    <field name="account_ids" widget="many2many_tags"/>
                    <field name="total_categ_ids" widget="many2many_tags"/>
                    <field name="write_date"/>
                </list></field>
        </record>
        <record id="view_cash_flows_form" model="ir.ui.view">
            <field name="name">cash.flows.form</field>
            <field name="model">cash.flows</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="categ_name"/>
                                <field name="report_type"/>
                                <field name="code"/>
                                <field name="parent_level"/>
                                <field name="apply_by"/>
                                <field name="stt_calculate"/>
                            </group>
                            <group>
                                <field invisible="report_type == 'statements_cash_flows'" name="account_ids" readonly="apply_by == 'total_categ'" widget="many2many_tags"/>
                                <field name="total_categ_ids" widget="many2many_tags"/>
                                <field invisible="1" name="in_business_cycle"/>
                                <field groups="base.group_no_one" name="is_bold_report"/>
                                <field groups="base.group_no_one" name="is_italic_report"/>
                                <field invisible="apply_by != 'accounting_balance_sheet'" name="target_id"/>
                                <field invisible="apply_by != 'accounting_balance_sheet'" name="column"/>
                            </group>
                        </group>
                        <notebook invisible="apply_by == 'total_categ'">
                            <page string="Set Method">
                                <field name="line_ids"><list editable="bottom">
                                        <field name="account_number_import_ids" string="Revenue Account Import" widget="many2many_tags"/>
                                        <field name="reciprocal_account_import_ids" string="Reciprocal Account Import" widget="many2many_tags"/>
                                        <field name="account_number_export_ids" string="Revenue Account Export" widget="many2many_tags"/>
                                        <field name="reciprocal_account_export_ids" string="Reciprocal Account Export" widget="many2many_tags"/>
                                        <field name="diary_book_ids" string="Diary Book" widget="many2many_tags"/>
                                    </list></field>
                            </page>
                        </notebook>
                    </sheet>
                </form></field>
        </record>
        <record id="action_cash_flows_sheet" model="ir.actions.act_window">
            <field name="name">Cash flows</field>
            <field name="res_model">cash.flows</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
