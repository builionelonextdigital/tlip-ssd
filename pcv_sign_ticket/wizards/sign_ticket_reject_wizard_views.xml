<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sign_ticket_reject_wizard_form" model="ir.ui.view">
        <field name="name">sign.ticket.reject.wizard.form</field>
        <field name="model">sign.ticket.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Ticket">
                <group>
                    <field name="ticket_id" invisible="1"/>
                    <field name="signer_id" invisible="1"/>
                    <field name="reason" required="1" />
                </group>
                <footer>
                    <button name="action_confirm_reject"
                        string="Reject"
                        type="object"
                        class="btn-primary"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
