<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sign_document_type_form" model="ir.ui.view">
        <field name="name">sign.document.type.form</field>
        <field name="model">sign.document.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                            class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Document Type Name"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="model_id"
                            options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="deadline_days"/>
                    </group>
                    <notebook>
                        <page name="other" string="Other">
                            <group>
                                <field name="use_cell_positioning"/>
                                <field name="placeholder_text"
                                    invisible="not use_cell_positioning"
                                    required="use_cell_positioning"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sign_document_type_list" model="ir.ui.view">
        <field name="name">sign.document.type.list</field>
        <field name="model">sign.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types">
                <field name="name"/>
                <field name="code"/>
                <field name="model_id"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_sign_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">sign.document.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
