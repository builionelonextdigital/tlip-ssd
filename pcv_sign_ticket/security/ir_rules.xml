<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sign_ticket_rule_multi_company" model="ir.rule">
        <field name="name">Sign Ticket: Multi-Company Rule</field>
        <field name="model_id" ref="model_sign_ticket"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="sign_ticket_rule_esign_user" model="ir.rule">
        <field name="name">Sign Ticket: E-Sign User access</field>
        <field name="model_id" ref="model_sign_ticket"/>
        <field name="groups" eval="[(4, ref('pcv_sign_ticket.group_sign_ticket_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="sign_ticket_rule_esign_signer" model="ir.rule">
        <field name="name">Sign Ticket: E-Sign Signer access</field>
        <field name="model_id" ref="model_sign_ticket"/>
        <field name="groups" eval="[(4, ref('pcv_sign_ticket.group_sign_ticket_user'))]"/>
        <field name="domain_force">[('signer_line_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Read-only: signers assigned to the ticket can read it, no write access -->
    <record id="sign_ticket_rule_read_only" model="ir.rule">
        <field name="name">Sign Ticket: E-Sign Read-only access</field>
        <field name="model_id" ref="model_sign_ticket"/>
        <field name="groups" eval="[(4, ref('pcv_sign_ticket.group_sign_ticket_read_only'))]"/>
        <field name="domain_force">[('signer_line_ids.user_id', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="sign_ticket_rule_esign_admin" model="ir.rule">
        <field name="name">Sign Ticket: E-Sign Admin access</field>
        <field name="model_id" ref="model_sign_ticket"/>
        <field name="groups" eval="[(4, ref('pcv_sign_ticket.group_sign_ticket_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
