<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="procurement_vendor_sequence" model="ir.sequence">
        <field name="name">Procurement Vendor Sequence</field>
        <field name="code">procurement.vendor</field>
        <field name="prefix">SUP-%(year)s%(range_month)s-</field>
        <field name="padding">2</field>
        <field name="number_increment">1</field>
        <field name="use_date_range" eval="True" />
        <field name="active" eval="True" />
    </record>
    <record id="leasing_customer_sequence" model="ir.sequence">
        <field name="name">Leasing Customer Sequence</field>
        <field name="code">leasing.customer</field>
        <field name="prefix">CUS-%(year)s%(range_month)s-</field>
        <field name="padding">2</field>
        <field name="number_increment">1</field>
        <field name="use_date_range" eval="True" />
        <field name="active" eval="True" />
    </record>
</odoo>