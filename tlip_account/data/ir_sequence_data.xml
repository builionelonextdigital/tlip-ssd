<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="budget_allocation_approval_sequence" model="ir.sequence">
        <field name="name">Budget Allocation Approval</field>
        <field name="code">budget.allocation.approval</field>
        <field name="prefix">BATRA/%(year)s/%(month)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range" eval="True"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
