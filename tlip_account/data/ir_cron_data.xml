<odoo>
    <data noupdate="1">
        <record id="ir_cron_check_overdue_invoices" model="ir.cron">
            <field name="name">Check Overdue Invoices</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._check_overdue_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
        </record>

        <record id="ir_cron_update_tlip_entry_code" model="ir.cron">
            <field name="name">TLIP - Update Entry Code for Old Payments</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_tlip_entry_code()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>

    </data>
</odoo>