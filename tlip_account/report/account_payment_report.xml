<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_account_payment" model="report.paperformat">
        <field name="name">Account Payment A4</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_account_payment" model="ir.actions.report">
        <field name="name">Payment Receipt</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tlip_account.report_account_payment</field>
        <field name="report_file">tlip_account.report_account_payment</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="paperformat_id" ref="tlip_account.paperformat_account_payment"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">(object.name or object.request_payment_number)</field>
    </record>

    <record id="account.action_report_payment_receipt" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>
