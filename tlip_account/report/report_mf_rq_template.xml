<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_mf_rq_document">
        <t t-call="tlip_base.tlip_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <t t-set="data" t-value="doc._generate_report_payment_request()" />
            <div class="page" style="font-family:Times New Roman">
                <div class="row" style="padding-top:20px">
                    <div class="col-3"></div>
                    <div class="col-6" style="text-align:center">
                        <h3>
                            <b>YÊU CẦU THANH TOÁN</b>
                        </h3>
                        <h3>
                            <b>REQUEST FOR PAYMENT</b>
                        </h3>
                        <p>Số/ <span style="font-style: italic">Ref :</span><t
                                t-esc="data['request_payment_number']" /></p>
                    </div>
                    <div class="col-3"></div>
                </div>
                <p>Ngày/<span style="font-style: italic"></span>Date: <span t-esc="data['date']" /></p>
                <p>Kính gửi/ <span style="font-style: italic"></span>Dear,</p>
                <p style="margin-bottom: 0">Khách hàng: <span t-esc="data['partner_name_vn']" /></p>
                <p>Customer: <span t-esc="data['partner_name_en']" /></p>
                <p style="margin-bottom: 0">Địa chỉ: <span t-esc="data['partner_address_vn']" /></p>
                <p>Address: <span t-esc="data['partner_address_en']" /></p>
                <p>Mã số thuế/ <span style="font-style: italic"></span>Tax code: <span
                        t-esc="data['vat']" /></p>
                <p>Loại hình doanh nghiệp/ <span style="font-style: italic"></span>Business Entity
                    Type: <t t-esc="data['business_type']" /></p>
                <p style="margin-bottom: 0">Căn cứ vào Điều <span
                        t-esc="data['contract_payment_article']" /> của Hợp đồng số <span
                        t-esc="data['contract_number']" /> ký ngày <span
                        t-esc="data['contract_signing_date']" /> và các Phụ lục Hợp đồng, đề nghị
                    Quý Khách hàng thanh toán cho chúng tôi Khoản tiền sau:</p>
                <p style="font-style: italic">In accordance with Article <span
                        t-esc="data['contract_payment_article']" /> of Agreement No. <span
                        t-esc="data['contract_number']" /> signed on <span
                        t-esc="data['contract_signing_date']" /> and Supplement Agreement, we would
                    like you to make payment for the fee to us as follow:</p>
                <p style="font-weight: bold; font-size:15pt; margin-bottom: 0">I. Nội dung thanh
                    toán/ <span
                        style="font-style:italic">Content of payment</span></p>
                <div class="row">
                    <div class="col-9"></div>
                    <div class="col-3">
                        <p>Đơn vị tiền tệ/ <span style="font-style:italic">Currency Unit</span>: <span
                                t-esc="data['currency']" /></p>
                    </div>
                </div>
                <table style="width: 100%; border-collapse: collapse;">
                    <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                    <thead style="display: table-row-group">
                        <tr>
                            <th
                                style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">
                                STT <br /><i>No</i><br />(1)</th>
                            <th
                                style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">Diễn
                                giải <br /><i>Description</i><br />(2)</th>
                            <th
                                style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">Đơn
                                vị tính <br /><i>Unit</i><br />(3)</th>
                            <th
                                style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">Diện
                                tích <br /><i>Area</i><br />(4)</th>
                            <th
                                style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">Số
                                lượng <br /><i>Quantity</i><br />(5)</th>
                            <th
                                style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">Đơn
                                giá <br /><i>Price</i><br />(6)</th>
                            <th
                                style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">Thành
                                tiền <br /><i>Amount</i><br />(7=4x5x6) or (7=5x6)</th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">
                        <t t-foreach="data['invoice_lines']" t-as="invoice_line">
                            <t t-set="has_tax_excluded" t-value="invoice_line['tax_excluded']" />
                            <tr style="vertical-align: middle;">
                                <td
                                    style="border: 1px solid black; padding: 8px;text-align: center;vertical-align: middle;"
                                    t-att-rowspan="2 if has_tax_excluded else 1">
                                    <span t-esc="invoice_line['index']" />
                                </td>
                                <td
                                    style="border: 1px solid black; padding-left: 8px;white-space:pre-line; word-wrap:break-word;vertical-align: middle;">
                                    <p t-esc="invoice_line['name']" />
                                </td>
                                <td
                                    style="border: 1px solid black; padding: 8px;vertical-align: middle;">
                                    <span t-esc="invoice_line['uom']" />
                                </td>
                                <td
                                    style="border: 1px solid black; padding: 8px;vertical-align: middle;">
                                    <span t-esc="invoice_line['area']" />
                                </td>
                                <td
                                    style="border: 1px solid black; padding: 8px;text-align: right;vertical-align: middle;">
                                    <span t-esc="invoice_line['quantity']" />
                                </td>
                                <td
                                    style="border: 1px solid black; padding: 8px;text-align: right;vertical-align: middle;">
                                    <span t-esc="invoice_line['price_unit']" />
                                </td>
                                <td
                                    style="border: 1px solid black; padding: 8px;text-align: right;vertical-align: middle;">
                                    <span t-esc="invoice_line['subtotal']" />
                                </td>
                            </tr>
                            <tr t-if="has_tax_excluded">
                                <td
                                    style="border: 1px solid black; padding-left: 8px;">
                                    <div>
                                        <span>Trong đó / <i>In which:</i></span>
                                        <br />
                                        <span>Tiền thuê đất không chịu thuế GTGT</span>
                                        <br/>
                                        <i>Land rent does not subject to VAT:</i>
                                    </div>
                                </td>
                                <td style="border: 1px solid black; padding: 8px;">

                                </td>
                                <td style="border: 1px solid black; padding: 8px;">

                                </td>
                                <td
                                    style="border: 1px solid black; padding: 8px;text-align: right;vertical-align: middle;">

                                </td>
                                <td
                                    style="border: 1px solid black; padding: 8px;text-align: right;vertical-align: middle;">

                                </td>
                                <td
                                    style="border: 1px solid black; padding: 8px;text-align: right;vertical-align: middle;">
                                    <span t-esc="invoice_line['tax_excluded']" />
                                </td>
                            </tr>
                        </t>
                        <tr>
                            <td
                                style="border: 1px solid black; padding: 8px; font-weight: bold; font-style: italic;"
                                colspan="6" class="bold italic">Cộng tiền hàng / <i>Sub-total:</i></td>
                            <td style="border: 1px solid black; padding: 8px;text-align: right;">
                                <span t-esc="data['amount_untaxed']" />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" class="bold italic"
                                style="border: 1px solid black; padding: 8px; font-weight: bold; font-style: italic;">Tiền
                                thuế GTGT / <i>VAT amount:</i></td>
                            <td style="border: 1px solid black; padding: 8px;text-align: right;">
                                <span t-esc="data['amount_tax']" />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" class="bold italic"
                                style="border: 1px solid black; padding: 8px; font-weight: bold; font-style: italic;">Tổng
                                tiền phải trả / <i>Total payable:</i></td>
                            <td style="border: 1px solid black; padding: 8px;text-align: right;">
                                <span t-esc="data['amount_total']" />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" class="bold"
                                style="border: 1px solid black; padding: 8px; font-weight: bold;">Giá
                                trị đã thanh toán / <i>Paid amount</i></td>
                            <td style="border: 1px solid black; padding: 8px;text-align: right;">
                                <span t-esc="data['paid_amount']" />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" class="bold"
                                style="border: 1px solid black; padding: 8px; font-weight: bold;">Tổng
                                tiền phải thanh toán / <i>Total payable amount</i></td>
                            <td style="border: 1px solid black; padding: 8px;text-align: right;">
                                <span t-esc="data['amount_residual']" />
                            </td>
                        </tr>
                        <tr rowspan="2">
                            <td colspan="7"
                                style="border: 1px solid black; padding: 8px; font-weight: bold;">
                                (Bằng chữ: <span style="white-space:pre" t-esc="data['amount_in_words_vn']"/>&#9;chẵn) <br />
                                (<i>In words: <span t-esc="data['amount_in_words_en']" />)</i>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="row mt-2 mb-2">
                    <div class="col-4">
                        <p style="font-weight: bold;font-size:15pt">II. Hạn thanh toán / <i>Due
                                date:</i></p>
                    </div>
                    <div class="col-4">
                        <span t-esc="data['due_date']" />
                    </div>
                </div>
                <div>
                    <p> Nếu hạn thanh toán trùng với ngày thứ 7, chủ nhật hoặc ngày lễ thì hạn thanh
                        toán sẽ được lùi lại vào ngày làm việc kế tiếp. <br />
                        <i>If the due date
                        falls on the weekend or holiday, the due date will be postponed to the next
                        working day.</i>
                    </p>
                </div>
                <p style="font-weight: bold;font-size:15pt">III. Thông tin tài khoản / <span
                        style="font-syle:italic"></span>Bank account:</p>
                <p style="margin-bottom: 0">Vui lòng chuyển số tiền phải trả vào tài khoản ngân hàng
                    của chúng tôi theo thông
                    tin sau: </p>
                <p style="font-style:italic">Please remit the payable amount to our bank account as
                    belows: </p>
                <div class="row">
                    <div class="col-3"> Tên tài khoản/ <span style="font-style:italic">Account Name</span>
                    </div>
                    <div class="col-4">
                        <span t-field="doc.company_id.name"></span>
                    </div>
                </div>
                <t t-if="data['company_bank_accounts']">
                    <div class="row">
                        <div class="col-3"> Số tài khoản/ <span style="font-style:italic">Account
                            Number</span>
                        </div>
                        <div class="col-9" style="padding-left:10px">
                            <span>
                                <b>
                                    <t t-esc="data['company_bank_accounts'][0]" />
                                </b>
                            </span>
                        </div>
                    </div>
                    <t t-if="len(data['company_bank_accounts']) &gt; 1">
                        <t t-foreach="data['company_bank_accounts'][1:]" t-as="company_bank_account">
                            <div class="row">
                                <div class="col-3"> Hoặc/ <span style="font-style:italic">Or</span>
                                </div>
                                <div class="col-9" style="padding-left:10px">
                                    <span>
                                        <b>
                                            <t t-esc="company_bank_account" />
                                        </b>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>

                <div class="row">
                    <div class="col-3"> Lưu ý/ <span style="font-style:italic">Note: </span>
                    </div>
                    <div class="col-9" style="padding-left:10px">
                        <b>Phí của ngân hàng sẽ được trả bởi khách hàng/ <span
                                style="font-style:italic">Bank's charge shall be borne by you.</span></b>
                    </div>
                </div>
                <br />

                <div class="mb-2">
                    <b>Nếu có vấn đề gì thắc mắc, vui lòng liên hệ với chúng tôi vào bất kỳ thời
                        gian nào.</b>
                    <br />
                    <span style="font-style:italic">
                        <b>If you have any queries on this matter, please feel free to contact us at
                            any time.</b>
                    </span>
                </div>
                <div style="margin-bottom: 50px;"> Xin chân thành cảm ơn / <i>Faithfully</i> yours, </div>

                <div style="font-weight: bold; margin-left: 40px"> ĐẠI DIỆN CÔNG TY <br />
                    <i>(ON
                    BEHALF OF COMPANY)</i>
                </div>

                <div style="margin-top: 70px; margin-left: 40px;">{{USER-SIGNATURE}}</div>
                <div class="oe_structure" />
            </div>
        </t>
    </template>

    <template id="report_mf_rq_raw">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="tlip_account.report_mf_rq_document"
                    t-lang="doc.partner_id.lang" />
            </t>
        </t>
    </template>

    <template id="mf_rq">
        <t t-call="tlip_account.report_mf_rq_raw" />
    </template>

</odoo>
