<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_power_3_document">
        <t t-call="tlip_base.tlip_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <t t-set="data" t-value="doc._generate_report_payment_request()" />
            <div class="page" style="font-family:Times New Roman">
                <div class="row" style="padding-top:20px">
                    <div class="col-3"></div>
                    <div class="col-6" style="text-align:center">
                        <h3>
                            <b>YÊU CẦU THANH TOÁN</b>
                        </h3>
                        <h3>
                            <b>REQUEST FOR PAYMENT</b>
                        </h3>
                        <p>Số/ <span style="font-style: italic">Ref :</span><t
                                t-esc="data['request_payment_number']" /></p>
                    </div>
                    <div class="col-3"></div>
                </div>
                <p style="margin-bottom: 0">Ngày/<i>Date:</i> <span t-esc="data['date']" /></p>
                <p>Kính gửi/ <span style="font-style: italic"></span>Dear,</p>
                <p style="margin-bottom: 0">Khách hàng: <span t-esc="data['partner_name_vn']" /></p>
                <p>Customer: <span t-esc="data['partner_name_en']" /></p>
                <p style="margin-bottom: 0">Địa chỉ: <span t-esc="data['partner_address_vn']" /></p>
                <p>Address: <span t-esc="data['partner_address_en']" /></p>
                <p>Mã số thuế/ <span style="font-style: italic"></span>Tax code: <span
                        t-esc="data['vat']" /></p>
                <div class="row mb-1">
                    <div class="col-6">
                        <p>Mã khách hàng/ <i>Tenant code: </i><span t-esc="data['partner_code']" /></p>
                    </div>
                    <div class="col-6">
                        <p>Mã điểm đo/ <i>Measuring point code: </i><span
                                t-esc="data['metering_point']" /></p>
                    </div>
                </div>
                <p>Loại hình doanh nghiệp/ <span style="font-style: italic"></span>Business Entity
                    Type: <t t-esc="data['business_type']" /></p>
                <p>Căn cứ vào Điều <span t-esc="data['contract_payment_article']" /> của Hợp đồng số <span
                        t-esc="data['contract_number']" /> ký ngày <span
                        t-esc="data['contract_signing_date']" /> và các Phụ lục Hợp đồng, đề nghị
                    Quý Khách hàng thanh toán cho chúng tôi Khoản tiền sau:</p>
                <p style="font-style: italic">In accordance with Article <span
                        t-esc="data['contract_payment_article']" /> of Agreement No. <span
                        t-esc="data['contract_number']" /> signed on <span
                        t-esc="data['contract_signing_date']" /> and Supplement Agreement, we would
                    like you to make payment for the fee to us as follow:</p>
                <p style="font-weight: bold; font-size:15pt; margin-bottom: 0">I. Nội dung thanh
                    toán/ <span
                        style="font-style:italic">Content of payment</span></p>
                <div class="row">
                    <div class="col-9"></div>
                    <div class="col-3">
                        <p>Đơn vị tiền tệ/ <span style="font-style:italic">Currency Unit</span>: <span
                                t-esc="data['currency']" /></p>
                    </div>
                </div>
                <table border="1" style="width: 100%; border-collapse: collapse;">
                    <tr>
                        <th
                            style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">STT
                            No</th>
                        <th
                            style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">Diễn
                            giải<br /><i>Description</i></th>
                        <th
                            style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">Số
                            lượng<br /><i>Quantity</i></th>
                        <th
                            style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">Hệ
                            số công suất<br /><i>Cosfi Ratio cosfi</i></th>
                        <th
                            style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">Hệ
                            số K (%)<br /><i>Ratio K (%)</i></th>
                        <th
                            style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">Tiền
                            điện năng hữu công<br /><i>Amount power</i></th>
                        <th
                            style="border: 1px solid black; padding: 8px; background-color: #f2f2f2;text-align: center;">Tiền
                            mua công suất phản kháng<br /><i>The amount reactive power</i></th>
                    </tr>
                    <tr>
                        <td style="border: 1px solid black; padding: 8px;text-align: center;">1</td>
                        <td style="border: 1px solid black; padding: 8px;">Giờ bình thường<br /><i>Normal
                            hours</i></td>
                        <td style="border: 1px solid black; padding: 8px;text-align: right;">
                            <span t-esc="data['electric_consumption'][0]['quantity']" />
                        </td>
                        <td style="border: 1px solid black; padding: 8px;text-align: right"
                            rowspan="4">
                            <span t-esc="data['invoice_lines'][0]['radio_cosfi']" />
                        </td>
                        <td style="border: 1px solid black; padding: 8px;text-align: right"
                            rowspan="4">
                            <span t-esc="data['invoice_lines'][0]['radio_kfactor']" />
                        </td>
                        <td style="border: 1px solid black; padding: 8px;text-align: right">
                            <span t-esc="data['electric_consumption'][0]['amount']" />
                        </td>
                        <td
                            style="border: 1px solid black; padding: 8px;vertical-align:middle;text-align:right"
                            rowspan="4">
                            <span t-esc="data['invoice_lines'][0]['subtotal']" />
                        </td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid black; padding: 8px;text-align: center">2</td>
                        <td style="border: 1px solid black; padding: 8px;">Giờ cao điểm<br /><i>High
                            hours</i></td>
                        <td style="border: 1px solid black; padding: 8px;text-align: right">
                            <span t-esc="data['electric_consumption'][1]['quantity']" />
                        </td>
                        <td style="border: 1px solid black; padding: 8px;text-align: right">
                            <span t-esc="data['electric_consumption'][1]['amount']" />
                        </td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid black; padding: 8px;text-align: center">3</td>
                        <td style="border: 1px solid black; padding: 8px">Giờ thấp điểm<br /><i>High
                            hours</i></td>
                        <td style="border: 1px solid black; padding: 8px;text-align: right">
                            <span t-esc="data['electric_consumption'][2]['quantity']" />
                        </td>
                        <td style="border: 1px solid black; padding: 8px;text-align: right">
                            <span t-esc="data['electric_consumption'][2]['amount']" />
                        </td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid black; padding: 8px;text-align: center">4</td>
                        <td style="border: 1px solid black; padding: 8px">Công suất phản kháng<br /><i>Reactive
                            power</i></td>
                        <td style="border: 1px solid black; padding: 8px;text-align: right">
                            <span t-esc="data['reative_power_quantity']" />
                        </td>
                        <td style="border: 1px solid black; padding: 8px;text-align: right"></td>
                    </tr>
                    <tr>
                        <td colspan="6"
                            style="border: 1px solid black; padding: 8px;text-align: right;">
                            <b>Cộng tiền hàng<br /><i>Sub-total:</i></b>
                        </td>
                        <td style="border: 1px solid black; padding: 8px;text-align: right">
                            <span t-esc="data['amount_untaxed']" />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6"
                            style="border: 1px solid black; padding: 8px;text-align: right;">
                            <b>Thuế suất GTGT 10%<br /><i>VAT amount:</i></b>
                        </td>
                        <td style="border: 1px solid black; padding: 8px;text-align: right;">
                            <span t-esc="data['amount_tax']" />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6"
                            style="border: 1px solid black; padding: 8px;text-align: right;">
                            <b>Tổng tiền phải trả<br /><i>Total payable:</i></b>
                        </td>
                        <td style="border: 1px solid black; padding: 8px;text-align: right;">
                            <span t-esc="data['amount_total']" />
                        </td>
                    </tr>
                </table>
                <div class="row mt-2 mb-2">
                    <div class="col-4">
                        <p style="font-weight: bold;font-size:15pt">II. Hạn thanh toán / <i>Due
                                date:</i></p>
                    </div>
                    <div class="col-4">
                        <span t-esc="data['due_date']" />
                    </div>
                </div>
                <p style="font-weight: bold;font-size:15pt">III. Thông tin tài khoản / <span
                        style="font-syle:italic"></span>Bank account:</p>
                <p style="margin-bottom: 0">Vui lòng chuyển số tiền phải trả vào tài khoản ngân hàng
                    của chúng tôi theo thông
                    tin sau: </p>
                <p style="font-style:italic">Please remit the payable amount to our bank account as
                    belows: </p>
                <div class="row">
                    <div class="col-3"> Tên tài khoản/ <span style="font-style:italic">Account Name</span>
                    </div>
                    <div class="col-4">
                        <span t-field="doc.company_id.name"></span>
                    </div>
                </div>

                <t t-if="data['company_bank_accounts']">
                    <div class="row">
                        <div class="col-3"> Số tài khoản/ <span style="font-style:italic">Account
                            Number</span>
                        </div>
                        <div class="col-9" style="padding-left:10px">
                            <span>
                                <b>
                                    <t t-esc="data['company_bank_accounts'][0]" />
                                </b>
                            </span>
                        </div>
                    </div>
                    <t t-if="len(data['company_bank_accounts']) &gt; 1">
                        <t t-foreach="data['company_bank_accounts'][1:]" t-as="company_bank_account">
                            <div class="row">
                                <div class="col-3"> Hoặc/ <span style="font-style:italic">Or</span>
                                </div>
                                <div class="col-9" style="padding-left:10px">
                                    <span>
                                        <b>
                                            <t t-esc="company_bank_account" />
                                        </b>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>

                <div class="row">
                    <div class="col-3"> Lưu ý/ <span style="font-style:italic">Note</span>
                    </div>
                    <div class="col-9" style="padding-left:10px">
                        <b>Phí của ngân hàng sẽ được trả bởi khách hàng/ <span
                                style="font-style:italic">Bank's charge shall be borne by you.</span></b>
                    </div>
                </div>
                <br />

                <p>
                    <b>Nếu có vấn đề gì thắc mắc, vui lòng liên hệ với chúng tôi vào bất kỳ thời
                        gian nào.</b>
                    <br />
                    <span style="font-style:italic">
                        <b>If you have any queries on this matter, please feel free to contact us at
                            any time.</b>
                    </span>
                </p>
                <div style="margin-bottom: 50px;"> Xin chân thành cảm ơn / <i>Faithfully</i> yours, </div>

                <div style="font-weight: bold; margin-left: 40px"> ĐẠI DIỆN CÔNG TY <br />
                    <i>(ON
                    BEHALF OF COMPANY)</i>
                </div>

                <div style="margin-top: 70px; margin-left: 40px;">{{USER-SIGNATURE}}</div>
                <div class="oe_structure" />
            </div>
        </t>
    </template>

    <template id="report_power_3_raw">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="tlip_account.report_power_3_document"
                    t-lang="doc.partner_id.lang" />
            </t>
        </t>
    </template>

    <template id="report_power_3">
        <t t-call="tlip_account.report_power_3_raw" />
    </template>

</odoo>
