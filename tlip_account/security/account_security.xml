<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.rule" id="account_move_user">
            <field name="name">Account Move internal user rule</field>
            <field name="model_id" ref="account.model_account_move" />
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
            <field name="domain_force">[('state', '=', 'draft'), ('create_uid','=',user.id)]</field>
            <field name="perm_create" eval="False" />
            <field name="perm_read" eval="False" />
        </record>
        <record model="ir.rule" id="account_payment_user">
            <field name="name">Account Payment internal user rule</field>
            <field name="model_id" ref="account.model_account_payment" />
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
            <field name="domain_force">[('state', '=', 'draft'), ('create_uid','=',user.id)]</field>
            <field name="perm_create" eval="False" />
            <field name="perm_read" eval="False" />
        </record>
        <record model="ir.rule" id="accounting_closing_period_rule">
            <field name="name">Account Closing Period Rule</field>
            <field name="model_id" ref="tlip_account.model_accounting_period_closing" />
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record model="ir.rule" id="account_payment_rfp_line_company_rule">
            <field name="name">Payment RFP Allocation: multi-company</field>
            <field name="model_id" ref="tlip_account.model_account_payment_rfp_line" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record model="ir.rule" id="bank_exchange_rate_rule">
            <field name="name">Bank Exhange Rate Rule</field>
            <field name="model_id" ref="tlip_account.model_bank_exchange_rate" />
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
        <record model="ir.rule" id="oos_mapping_company">
            <field name="name">OOS Mapping Multi-company</field>
            <field name="model_id" ref="tlip_account.model_oos_mapping" />
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>

        <record model="ir.rule" id="batch_payment_delete">
            <field name="name">Account Record Payment Delete Rule</field>
            <field name="model_id" ref="tlip_account.model_batch_payment" />
            <field name="domain_force">[('approval_state', '=', 'draft')]</field>
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_read" eval="False" />
        </record>

        <record model="ir.rule" id="batch_payment_company">
            <field name="name">Account Record Payment Multi-company</field>
            <field name="model_id" ref="tlip_account.model_batch_payment" />
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>

        <record model="ir.rule" id="budget_allocation_approval_company">
            <field name="name">Budget Allocation Multi-company</field>
            <field name="model_id" ref="tlip_account.model_budget_allocation_approval" />
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>

        <record model="ir.rule" id="salary_distribution_report_company">
            <field name="name">Salary Distribution Report Multi-company</field>
            <field name="model_id" ref="tlip_account.model_salary_distribution_report" />
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>

        <record model="ir.rule" id="budget_reserved_company">
            <field name="name">Budget Reserved Multi-company</field>
            <field name="model_id" ref="tlip_account.model_budget_reserved" />
            <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
        </record>
    </data>
</odoo>
