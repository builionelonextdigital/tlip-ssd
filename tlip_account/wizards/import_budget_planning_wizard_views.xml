<?xml version="1.0"?>
<odoo>

    <record id="import_budget_planning_wizard_form_view" model="ir.ui.view">
        <field name="name">import.budget.planning.wizard.form.view</field>
        <field name="model">import.budget.planning.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Your File">
                <p class="text-muted">You can download the sample import template: <a
                        target="_blank"
                        href="/tlip_account/static/import_templates/template_budget.xlsx">
                    Template.xlsx</a></p>
                <group>
                    <group>
                        <field name="budget_analytic_year_id" invisible="1" />
                        <field name="type" widget="radio" options="{'horizontal': true}" />
                        <field name="company_id" />
                        <field name="import_file" colspan="2" invisible="imported == True"
                            string="File" filename="filename" />
                        <field name="filename" invisible="1" />
                    </group>
                </group>
                <footer>
                    <button name="button_import" string="Confirm" type="object" class="btn-primary"
                        invisible="imported == True" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>