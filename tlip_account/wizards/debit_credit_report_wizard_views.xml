<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="debit_credit_report_wizard_form" model="ir.ui.view">
        <field name="name">debit.credit.report.wizard.form</field>
        <field name="model">debit.credit.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="from_date" />
                            <field name="to_date" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print" string="Print" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="debit_credit_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Print Debit and Credit Control List</field>
        <field name="res_model">debit.credit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="debit_credit_report_wizard_menu" name="Print Debit and Credit Control List"
        action="debit_credit_report_wizard_action"
        parent="biz_vietnamese_accounting_menu.menu_accounting_vn_report" sequence="0" />
</odoo>