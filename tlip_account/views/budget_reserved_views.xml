<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_reserved_tree" model="ir.ui.view">
        <field name="name">budget.reserved.tree</field>
        <field name="model">budget.reserved</field>
        <field name="arch" type="xml">
            <list string="Budget Reserved">
                <field name="account_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_budget_reserved_form" model="ir.ui.view">
        <field name="name">budget.reserved.form</field>
        <field name="model">budget.reserved</field>
        <field name="arch" type="xml">
            <form string="Budget Reserved">
                <sheet>
                    <group name="basic_info">
                        <group>
                            <field name="account_id"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_budget_reserved" model="ir.actions.act_window">
        <field name="name">Budget Reserved</field>
        <field name="res_model">budget.reserved</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'delete': False, 'edit': False}</field>
    </record>
</odoo>
