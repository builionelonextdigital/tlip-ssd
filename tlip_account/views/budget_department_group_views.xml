<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="budget_department_group_view_tree" model="ir.ui.view">
        <field name="name">budget.department.group.view.tree</field>
        <field name="model">budget.department.group</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="name" />
                <field name="job_id" />
            </list>
        </field>
    </record>

    <record id="budget_department_group_view_form" model="ir.ui.view">
        <field name="name">budget.department.group.view.form</field>
        <field name="model">budget.department.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="job_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="budget_department_ids" widget="many2many" domain="[('department_group_id', '=', False)]">
                            <list create="0" edit="0" editable="bottom">
                                <field name="name" />
                                <field name="code" />
                                <field name="job_id" />
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="budget_department_group_view_search" model="ir.ui.view">
        <field name="name">budget.department.group.view.search</field>
        <field name="model">budget.department.group</field>
        <field name="arch" type="xml">
            <search string="Department Groups">
                <field name="name" string="Department Group" />
            </search>
        </field>
    </record>

    <record id="budget_department_group_action" model="ir.actions.act_window">
        <field name="name">Budget Department Groups</field>
        <field name="res_model">budget.department.group</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>