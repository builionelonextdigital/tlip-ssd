<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="budget_analytic_year_view_form" model="ir.ui.view">
        <field name="name">budget.analytic.year.view.form</field>
        <field name="model">budget.analytic.year</field>
        <field name="arch" type="xml">
            <form string="Budgets Yearly">
                <header>
                    <button string="Reset to Draft" name="action_budget_draft"
                        confirm="Are you sure that you want to do this action?"
                        invisible="state == 'draft'" type="object"
                        class="btn-primary" />
                    <button string="Open" name="action_budget_confirm" invisible="state != 'draft'"
                        confirm="Are you sure that you want to do this action?"
                        type="object"
                        class="btn-primary" />
                    <button string="Cancel Budget" name="action_budget_cancel"
                        confirm="Are you sure that you want to do this action?"
                        invisible="state != 'draft'" type="object"
                        class="btn-secondary" />
                    <button string="Import"
                        name="open_import_budget_planning_wizard"
                        invisible="state != 'confirmed'" type="object"
                        class="btn-primary" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done" />
                </header>
                <sheet string="Budget Yearly">
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" readonly="state != 'draft'"
                                placeholder="e.g. Budget 2023" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="fiscal_year_id" readonly="state != 'draft'"
                                options="{'no_create': True, 'no_open': True, 'no_create_edit': True}" />
                            <field name="company_id" groups="base.group_multi_company"
                                options="{'no_create': True, 'no_open': True}"
                                readonly="state != 'draft'" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Budget Periods" name="budget_periods">
                            <field name="monthly_line_ids" colspan="4" readonly="1">
                                <list string="Budget Periods">
                                    <field name="currency_id" column_invisible="True" />
                                    <field name="name" string="Budget Analytic" />
                                    <button name="open_budget_analytic"
                                        type="object"
                                        class="fa fa-list"
                                        title="Open Budget Analytic" />
                                    <field name="date_from" />
                                    <field name="date_to" />
                                    <field name="planning_budget_amount" sum="Budget" />
                                    <field name="budget_amount" sum="Cashflow" />
                                    <field name="committed_amount" sum="Reserved" />
                                    <field name="achieved_amount" sum="Used" />
                                    <field name="additional_amount" sum="Additional" />
                                    <field name="remained_amount" sum="Remained" />
                                </list>
                            </field>
                        </page>
                        <page string="Budget Codes" name="budget_codes">
                            <field name="budget_line_year_ids" colspan="4" readonly="1">
                                <list string="Budget Codes" no_open="true">
                                    <field name="currency_id" column_invisible="True" />
                                    <field name="account_id" column_invisible="True" />
                                    <field name="budget_code_id" />
                                    <field name="budget_department_id" />
                                    <field name="planning_budget_amount" sum="Budget" />
                                    <field name="budget_amount" sum="Cashflow" />
                                    <field name="committed_amount" sum="Reserved" />
                                    <field name="achieved_amount" sum="Used" />
                                    <field name="additional_amount" sum="Additional" />
                                    <field name="remained_amount" sum="Remained" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="budget_analytic_year_view_tree" model="ir.ui.view">
        <field name="name">budget.analytic.year.view.tree</field>
        <field name="model">budget.analytic.year</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-muted="state == 'canceled'"
                string="Budgets Yearly">
                <field name="name" />
                <field name="fiscal_year_id" />
                <field name="company_id" groups="base.group_multi_company" optional="hide" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="budget_analytic_year_view_search" model="ir.ui.view">
        <field name="name">budget.analytic.year.search</field>
        <field name="model">budget.analytic.year</field>
        <field name="arch" type="xml">
            <search string="Budget Yearly">
                <field name="name" string="Budget Yearly" />
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"
                    help="Draft Budgets" />
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_budget_analytic_year_action">
        <field name="name">Budgets Yearly</field>
        <field name="res_model">budget.analytic.year</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
    </record>

</odoo>
