<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_view_form" model="ir.ui.view">
        <field name="name">res_company.view.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <field name="website" position="after">
                <field name="company_einvoice_url" string="eInvoice Website" />
                <field name="invoice_mail_server_id" string="Invocie Mail Server" />
            </field>
        </field>
    </record>
</odoo>
