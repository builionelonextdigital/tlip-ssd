<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_bank_exchange_rate" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.bank.exchange.rate</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40" />
            <field name="inherit_id" ref="account.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <setting id="update_exchange_rates" position="after">
                    <setting id="default_bank_exchange_rate" string="Default Bank Exchange Rate"
                        company_dependent="1"
                        documentation="/applications/finance/accounting/others/multi_currency.html"
                        help="Default bank exchange rate for your company">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="bank_exchange_rate_id" class="col-lg-3 o_light_label"
                                    string="Bank" />
                                <field name="bank_exchange_rate_id"
                                    options="{'no_create_edit': True, 'no_open': True}"
                                    context="{'active_test': False}" />
                            </div>
                        </div>
                    </setting>
                </setting>
                <setting id="invoice_delivery_addresses" position="after">
                    <setting id="deposit_percent_amount" string="Deposit Percent Amount (in %)">
                        <field name="deposit_percent_amount" widget="percent"/>
                    </setting>
                </setting>

            </field>
        </record>
    </data>
</odoo>