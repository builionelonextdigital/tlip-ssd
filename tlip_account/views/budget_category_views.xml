<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="budget_category_view_tree" model="ir.ui.view">
        <field name="name">budget.category.view.tree</field>
        <field name="model">budget.category</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="name" />
                <field name="code" />
            </list>
        </field>
    </record>

    <record id="budget_category_view_form" model="ir.ui.view">
        <field name="name">budget.category.view.form</field>
        <field name="model">budget.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_budget_codes"
                            icon="fa-list">
                            <field name="count_budget_code" widget="statinfo" string="Budget Codes" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Category" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Investment" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" options='{"no_create": True}' />
                            <field name="code" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="budget_category_action" model="ir.actions.act_window">
        <field name="name">Budget Categories</field>
        <field name="res_model">budget.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="budget_category_menu"
        name="Budget Categories"
        action="tlip_account.budget_category_action"
        parent="account.menu_analytic_accounting"
        sequence="1"/>

</odoo>
