<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account.view_account_payment_form" model="ir.ui.view">
        <field name="groups_id" eval="[(4, ref('account.group_account_basic'))]" />
    </record>
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.view.inherit.reconcile_item_ids</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="approval_state"
                    readonly="1" widget="statusbar"
                    statusbar_visible="draft,wait_for_approval,approved"
                    invisible="approval_state == 'approved' or state != 'draft' or not is_request_payment"
                />
                <field name="accounting_approval_state"
                    readonly="1" widget="statusbar"
                    statusbar_visible="draft,wait_for_approval,approved"
                    invisible="(is_request_payment and approval_state != 'approved') or state != 'draft' or accounting_approval_state == 'approved'"
                />
            </field>
            <field name="state" position="attributes">
                <attribute name="invisible">accounting_approval_state != 'approved' and state == 'draft'</attribute>
            </field>
            <field name="payment_type" position="after">
                <field name="invoice_type_id" required="is_request_payment and payment_type == 'inbound'"
                    invisible="payment_type == 'outbound'"
                    readonly="approval_state != 'draft'" />
            </field>
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="invisible">state != 'draft' or accounting_approval_state != 'approved'</attribute>
                <attribute name="groups">account.group_account_basic</attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">not id or not (state == 'draft' or (state == 'in_process' and is_sent)) or accounting_approval_state in ('wait_for_approval', 'withdrawn', 'rejected')</attribute>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="after">
                <!-- Normal Approval Flow -->
                <button name="action_submit_approval" string="Submit" type="object"
                    class="btn btn-primary"
                    invisible="state != 'draft' or approval_state != 'draft' or not is_request_payment" confirm="Are you sure that you want to do this action?" />
                <button name="action_approve_request" type="object" string="Approve"
                    invisible="user_status != 'pending' or approval_state != 'wait_for_approval' or not is_request_payment"
                    class="btn-primary" data-hotkey="v" confirm="Are you sure that you want to do this action?" />
                <button name="action_reject_request" string="Refuse" type="object"
                    invisible="user_status != 'pending' or approval_state != 'wait_for_approval' or not is_request_payment"
                    data-hotkey="z" confirm="Are you sure that you want to do this action?" />
                <button name="action_withdraw_approval" string="Withdraw" type="object"
                    confirm="Are you sure that you want to do this action?"
                    invisible="approval_state != 'wait_for_approval' or not is_request_payment" />
                <button name="action_reset_approval" string="Reset Approval" type="object"
                    invisible="approval_state not in ('rejected', 'withdrawn') or not is_request_payment"
                    confirm="Are you sure that you want to do this action?" />
                <!-- Accounting Approval Flow -->
                <button name="action_submit_approval" string="Submit" type="object"
                    groups="account.group_account_basic"
                    class="btn btn-primary"
                    invisible="state != 'draft' or accounting_approval_state != 'draft' or (is_request_payment and approval_state != 'approved')" confirm="Are you sure that you want to do this action?" />
                <button name="action_approve_request" type="object" string="Approve"
                    invisible="user_status != 'pending' or accounting_approval_state != 'wait_for_approval' or (is_request_payment and approval_state != 'approved')"
                    class="btn-primary" data-hotkey="v" confirm="Are you sure that you want to do this action?" />
                <button name="action_reject_request" string="Refuse" type="object"
                    invisible="user_status != 'pending' or accounting_approval_state != 'wait_for_approval' or (is_request_payment and approval_state != 'approved')"
                    data-hotkey="z" confirm="Are you sure that you want to do this action?" />
                <button name="action_withdraw_approval" string="Withdraw" type="object"
                    confirm="Are you sure that you want to do this action?"
                    invisible="accounting_approval_state != 'wait_for_approval' or (is_request_payment and approval_state != 'approved')" />
                <button name="action_accounting_reset_approval" string="Reset Approval"
                    type="object"
                    invisible="accounting_approval_state not in ('rejected', 'withdrawn')"
                    confirm="Are you sure that you want to do this action?" />
            </xpath>
            <xpath expr="//div[@name='button_box']//button[1]" position="before">
                <button class="oe_stat_button" name="action_open_approval_history_ids"
                    type="object"
                    icon="fa-history">
                    <div class="o_stat_info">
                        <span class="o_stat_text">
                            Approval Requests
                        </span>
                    </div>
                </button>
            </xpath>

            <field name="date" position="before">
                <label for="entry_amount_currency" string="Amount in Currency" />
                <div name="amount_div" class="o_row">
                    <field name="entry_amount_currency"
                        readonly="approval_state == 'approved'"
                        options="{'currency_field': 'foreign_currency_id', 'field_digits': True}"
                        required="foreign_currency_id" />
                    <field name="foreign_currency_id" domain="[('id', '!=', currency_id)]"
                        readonly="approval_state == 'approved'"
                        options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" />
                </div>
                <field name="entry_currency_rate"
                    readonly="approval_state == 'approved'"
                    invisible="not foreign_currency_id"
                    required="foreign_currency_id" />
                <field name="approval_readonly" invisible="1" />
            </field>

            <field name="journal_id" position="before">
                <field name="date" position="move" />
                <field name="is_accountant_user" invisible="1" />
                <field name="due_date" required="payment_type == 'outbound'"
                    invisible="not is_request_payment" />
                <field name="confirmed_due_date" required="is_accountant_user and payment_type == 'outbound' and state == 'draft'"
                    invisible="not is_accountant_user or payment_type != 'outbound'"
                    readonly="state != 'draft'" />
            </field>

            <field name="date" position="attributes">
                <attribute name="readonly">approval_readonly and not (is_accountant_user and state == 'draft' and accounting_approval_state == 'approved')</attribute>
            </field>

            <sheet position="inside">
                <notebook>
                    <page name="rfp_matching" string="Request for Payments"
                        invisible="payment_type != 'inbound'">
                        <field name="available_rfp_move_ids" invisible="1" />
                        <field name="rfp_line_ids" nolabel="1" readonly="state != 'draft'">
                            <list editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="company_id" column_invisible="True" />
                                <field name="currency_id" column_invisible="True" />
                                <field name="move_id"
                                    domain="[('id', 'in', parent.available_rfp_move_ids)]"
                                    options="{'no_create': True}" />
                                <field name="invoice_date" />
                                <field name="invoice_date_due" optional="show" />
                                <field name="move_approval_state" widget="badge" optional="hide" />
                                <field name="move_state" widget="badge"
                                    decoration-success="move_state == 'posted'"
                                    decoration-info="move_state == 'draft'" />
                                <field name="move_amount_total" optional="hide" />
                                <field name="move_amount_open" />
                                <field name="amount" sum="Total" />
                            </list>
                        </field>
                        <group class="oe_subtotal_footer">
                            <field name="rfp_allocated_amount" />
                        </group>
                    </page>
                    <page name="reconcile" string="Bills" invisible="(is_advance_payment and not auto_reconcile_item_ids) or payment_type == 'inbound'">
                        <field name="available_reconcile_item_ids" invisible="1" />
                        <field name="auto_reconcile_item_ids" colspan="2" nolabel="1"
                            readonly="state != 'draft'"
                            domain="[('id', 'in', available_reconcile_item_ids)]">
                            <list>
                                <field name="date" />
                                <field name="move_name" string="Journal Entry"
                                    widget="open_move_widget" />
                                <field name="account_id" />
                                <field name="partner_id" optional="hide" />
                                <field name="ref" optional="hide" />
                                <field name="name" optional="hide" />
                                <field name="amount_currency" optional="hide" />
                                <field name="currency_id" optional="hide" />
                                <field name="debit" optional="show" />
                                <field name="credit" optional="show" />
                            </list>
                        </field>
                    </page>
                    <page name='contract_info' string="Contract Info">
                        <group>
                            <group string="Contract">
                                <field name="contract_number"
                                    readonly="approval_state != 'draft' or accounting_approval_state != 'draft'" />
                                <field name="contract_signing_date"
                                    readonly="approval_state != 'draft' or accounting_approval_state != 'draft'" />
                            </group>
                            <group string="Payment">
                                <field name="contract_payment_article"
                                    readonly="approval_state != 'draft' or accounting_approval_state != 'draft'" />
                            </group>
                        </group>
                    </page>
                    <page string="Approver(s)" name="approver" invisible="not approver_ids">
                        <field name="approver_ids" mode="list" readonly="1">
                            <list editable="bottom" decoration-success="status=='approved'"
                                decoration-warning="status in ['pending', 'waiting']"
                                decoration-danger="status=='refused'" no_open="1">
                                <field name="existing_request_user_ids" column_invisible="True" />
                                <field name="sequence" column_invisible="True" />
                                <field name="user_id" string="Approver"
                                    required="not job_id" />
                                <field name="job_id" required="not user_id" />
                                <field name="status" />
                                <field name="company_id" column_invisible="True" />
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
            <xpath expr="//field[@name='partner_bank_id'][1]" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id'][2]" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id'][3]" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='memo']" position="attributes">
                <attribute name="readonly">approval_readonly and not (is_accountant_user and state == 'draft' and accounting_approval_state == 'approved')</attribute>
            </xpath>
            <field name="partner_bank_id" position="after">
                <field name="development_phase_id" readonly="state != 'draft'"
                    options="{'no_create': True, 'no_create_edit': True}" />
                <field name="development_project_id" readonly="state != 'draft'"
                    options="{'no_create': True, 'no_create_edit': True}" />
                <field name="analytic_distribution" 
                    widget="analytic_distribution" 
                    readonly="state != 'draft'" string="Budget Code"/>
                <field name="destination_account_id"
                    readonly="state != 'draft'" string="Counterpart Account"
                    options="{'no_create': True, 'no_create_edit': True}" />
                <field name="show_diff_in_currency" invisible="True" />
                <label for="diff_in_currency" invisible="not show_diff_in_currency" />
                <div invisible="not show_diff_in_currency">
                    <field name="journal_entry_currency_id" invisible="1" />
                    <field name="diff_in_currency"
                        widget="monetary"
                        options="{'currency_field': 'journal_entry_currency_id', 'field_digits': True}" />
                    <field name="diff_in_currency_handling"
                        readonly="state != 'draft'"
                        widget="radio" nolabel="1" />
                    <div class="o_inner_group grid col-lg-12 p-0"
                        invisible="diff_in_currency_handling == 'open'">
                        <div class="o_wrap_field d-flex d-sm-contents flex-column mb-3 mb-sm-0">
                            <div class="o_cell o_wrap_label text-break text-900">
                                <label for="writeoff_account_id" string="Post Difference In"
                                    class="oe_edit_only" />
                            </div>
                            <div class="o_cell o_wrap_input text-break">
                                <field name="writeoff_account_id"
                                    readonly="state != 'draft'"
                                    string="Post Difference In" options="{'no_create': True}"
                                    required="diff_in_currency_handling == 'reconcile'" />
                            </div>
                        </div>
                        <div class="o_wrap_field d-flex d-sm-contents flex-column mb-3 mb-sm-0">
                            <div class="o_cell o_wrap_label text-break text-900">
                                <label for="writeoff_label" class="oe_edit_only" string="Label" />
                            </div>
                            <div class="o_cell o_wrap_input text-break">
                                <field name="writeoff_label"
                                    readonly="state != 'draft'"
                                    required="diff_in_currency_handling == 'reconcile'" />
                            </div>
                        </div>
                    </div>
                </div>
            </field>
        </field>
    </record>

    <record id="view_account_payment_tree_inherit_module_name" model="ir.ui.view">
        <field name="name">account.payment.view.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="approval_state" widget="badge"
                    decoration-info="approval_state=='draft'"
                    decoration-warning="approval_state=='wait_for_approval'"
                    decoration-danger="approval_state in ('rejected', 'cancel')"
                    decoration-success="approval_state=='approved'" />
                <field name="accounting_state" widget="badge"
                    decoration-info="accounting_state=='draft'"
                    decoration-warning="accounting_state in ('wait_for_approval', 'wait_to_paid')"
                    decoration-success="accounting_state=='paid'" />
            </field>
        </field>
    </record>

    <record id="view_account_payment_tree" model="ir.ui.view">
        <field name="name">account.payment.tree.view.inherit.accountant</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="string">Partner</attribute>
            </field>
            <field name="date" position="after">
                <field name="due_date" />
            </field>
            <field name="name" position="after">
                <field name="payment_type" />
            </field>
            <field name="approval_state" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="view_account_payment_form_inherit_accountant" model="ir.ui.view">
        <field name="name">account.payment.form.view.inherit.accoutant</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="tlip_account.view_account_payment_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <!-- This view inherits the form view of the account.payment model and replace the general Accounting/Payments with label Parnter. -->
            <xpath expr="//field[@name='partner_id'][1]" position="attributes">
                <attribute name="string">Partner</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id'][2]" position="attributes">
                <attribute name="string">Partner</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id'][1]" position="attributes">
                <attribute name="string">Partner Bank Account</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id'][2]" position="attributes">
                <attribute name="string">Partner Bank Account</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search_inherit" model="ir.ui.view">
        <field name="name">account.payment.search.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <separator/>
                <filter name="filter_approvals_to_review" string="My Approvals to Review"
                    domain="['&amp;', '|', ('current_approver_id.job_id.employee_ids.user_id', 'in', [uid]), ('current_approver_id.user_id', '=', uid), '|', ('approval_state', '=', 'wait_for_approval'), ('accounting_approval_state', '=', 'wait_for_approval')]" />
            </field>
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', '|', '|', '|', '|', ('name', 'ilike', self), ('partner_id', 'ilike', self), ('memo', 'ilike', self), ('amount_company_currency_signed', 'ilike', self), ('amount', 'ilike', self), ('request_payment_number', 'ilike', self)]
                </attribute>
            </field>
        </field>
    </record>

    <record id="accountant_account_payment_partner_action" model="ir.actions.act_window">
        <field name="name">Payment</field>
        <field name="res_model">account.payment</field>
        <field name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('tlip_account.view_account_payment_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('tlip_account.view_account_payment_form_inherit_accountant')})]" />
        <field name="domain">[]</field>
        <field name="context">{
            'default_payment_type': 'inbound',
            'default_partner_type': 'customer',
            'default_move_journal_types': ('bank', 'cash'),
            'display_account_trust': True,
            }</field>
    </record>

    <record id="account_payment_action_multi_submit_approval" model="ir.actions.server">
        <field name="name">Submit</field>
        <field name="model_id" ref="account.model_account_payment" />
        <field name="binding_model_id" ref="account.model_account_payment" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
            records.action_multi_submit_approval()
        </field>
    </record>

    <record id="account_payment_action_multi_approve_approval" model="ir.actions.server">
        <field name="name">Approve</field>
        <field name="model_id" ref="account.model_account_payment" />
        <field name="binding_model_id" ref="account.model_account_payment" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
            records.action_multi_approve_approval()
        </field>
    </record>

</odoo>