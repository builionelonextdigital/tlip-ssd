<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="analytic_report_view_tree" model="ir.ui.view">
        <field name="name">analytic.report.view.tree</field>
        <field name="model">analytic.report</field>
        <field name="arch" type="xml">
            <list string="Analytic Reports">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="analytic_report_view_form" model="ir.ui.view">
        <field name="name">analytic.report.view.form</field>
        <field name="model">analytic.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <label for="name" />
                    <h1>
                        <field name="name" string="Analytic Report" />
                    </h1>
                    <notebook>
                        <page name="line_ids" string="Budget Codes">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="account_id"
                                        options="{'no_create': True, 'no_create_edit': True}" />
                                    <field name="budget_main_categ_id"
                                        options="{'no_create': True, 'no_create_edit': True}" />
                                    <field name="budget_2nd_categ_id"
                                        options="{'no_create': True, 'no_create_edit': True}" />
                                    <field name="budget_detailed_categ_id"
                                        options="{'no_create': True, 'no_create_edit': True}" />
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="analytic_reports_action" model="ir.actions.act_window">
        <field name="name">Analytic Reports</field>
        <field name="res_model">analytic.report</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>