<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="accounting_period_closing_view_tree" model="ir.ui.view">
        <field name="name">accounting.period.closing.view.tree</field>
        <field name="model">accounting.period.closing</field>
        <field name="arch" type="xml">
            <list string="Month-end Closing">
                <field name="name" />
                <field name="state"
                    widget="badge"
                    decoration-muted="state == 'draft'"
                    decoration-danger="state == 'closed'"
                    decoration-success="state == 'open'" />
                <field name="company_id" />
            </list>
        </field>
    </record>

    <record id="accounting_period_closing_view_form" model="ir.ui.view">
        <field name="name">accounting.period.closing.view.form</field>
        <field name="model">accounting.period.closing</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" string="Open" type="object"
                        class="oe_highlight" confirm="Are you sure that you want to do this action?"
                        invisible="state != 'draft'" groups="account.group_account_manager" />
                    <button name="action_oos_sync" string="Sync OOS" type="object"
                        confirm="Are you sure that you want to do this action?"
                        class="oe_highlight"
                        invisible="state != 'open'" />
                    <button name="action_close" string="Close" type="object"
                        class="oe_highlight" confirm="Are you sure that you want to do this action?"
                        invisible="state != 'open'" groups="account.group_account_manager" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" invisible="1" />
                            <field name="accounting_period" invisible="1" />
                            <field name="company_id" invisible="1" />
                            <label for="month" string="Month/Year" />
                            <div class="o_row">
                                <field name="month" placeholder="Month" class="oe_inline"
                                    readonly="state != 'draft'" />
                                <span class="oe_inline">/</span>
                                <field name="year" placeholder="Year" class="oe_inline"
                                    readonly="state != 'draft'" />
                            </div>
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="accounting_period_closing_action" model="ir.actions.act_window">
        <field name="name">Month-end Closing</field>
        <field name="res_model">accounting.period.closing</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
