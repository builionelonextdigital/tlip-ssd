<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_analytic_line_form_view_inherit_budget_category" model="ir.ui.view">
        <field name="name">account.analytic.line.form.view.inherit.budget_category</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_form" />
        <field name="arch" type="xml">
            <group name="amount" position="after">
                <group name="budget_structure" string="Budget Structure">
                    <field name="budget_main_categ_id"
                        options="{'no_create': True, 'no_create_edit': True}" />
                    <field name="budget_2nd_categ_id"
                        options="{'no_create': True, 'no_create_edit': True}" />
                    <field name="budget_detailed_categ_id"
                        options="{'no_create': True, 'no_create_edit': True}" />
                </group>
            </group>
        </field>
    </record>
</odoo>