<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="invoice_type_view_tree" model="ir.ui.view">
        <field name="name">invoice.type.view.tree</field>
        <field name="model">invoice.type</field>
        <field name="arch" type="xml">
            <list string="Invoice Type">
                <field name="name_en" />
                <field name="name_vn" />
                <field name="type" />
            </list>
        </field>
    </record>

    <record id="invoice_type_view_form" model="ir.ui.view">
        <field name="name">invoice.type.view.form</field>
        <field name="model">invoice.type</field>
        <field name="arch" type="xml">
            <form string="Invoice Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name_en" />
                            <field name="type" />
                            <field name="utility_type" invisible="type != 'utility'" required="type == 'utility'"/>
                            <field name="leasing_type" invisible="type != 'leasing'" />
                            <field name="utility_quantity_based_on" invisible="type != 'utility'" required="type == 'utility'" />
                            <field name="tax_calculation_rounding_method"/>
                        </group>
                        <group>
                            <field name="name_vn" />
                            <field name="report_payment_request_id"
                                required="True"
                                options="{'no_create': True, 'no_create_edit': True}" />
                            <field name="minvoice_template_ids" widget="many2many_tags" required="0"
                                options="{'no_create': True, 'no_open': True}" />
                            <field name="payment_method" required="0" />
                            <field name="product_category_ids" widget="many2many_tags" />
                            <field name="request_sequence_ids" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="invoice_type_action" model="ir.actions.act_window">
        <field name="name">Invoice Type</field>
        <field name="res_model">invoice.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
