<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="budget_line_year_simple_view_form" model="ir.ui.view">
        <field name="name">budget_line_year_simple.view.form</field>
        <field name="model">budget.line.year</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="account_id" invisible="1"/>
                            <field name="budget_code_id" />
                            <field name="budget_department_id" />
                        </group>
                        <group>
                            <field name="budget_amount" />
                            <field name="achieved_amount" />
                            <field name="remained_amount" />
                            <field name="committed_amount" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
