<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="uom_uom_form_view_inherit_leasing_type" model="ir.ui.view">
        <field name="name">uom.uom.form.view.inherit</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.product_uom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='rounding']" position="after">
                <field name="leasing_type"/>
                <field name="uom_invoice_vn" />
                <field name="uom_invoice_en" />
            </xpath>
        </field>
    </record>

    <record id="uom_category_form_view_inherit_leasing_type" model="ir.ui.view">
        <field name="name">uom.category.form.view.inherit</field>
        <field name="model">uom.category</field>
        <field name="inherit_id" ref="uom.product_uom_categ_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_ids']/list/field[@name='rounding']" position="after">
                <field name="leasing_type"/>
                <field name="uom_invoice_vn" />
                <field name="uom_invoice_en" />
            </xpath>
        </field>
    </record>
</odoo>