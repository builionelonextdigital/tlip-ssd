<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_bank_inherit_tlip_account" model="ir.ui.view">
        <field name="name">res.partner.bank.view.form.inherit.tlip.account</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group name="linked_accounts" string="Linked Accounts">
                    <field name="account_ids" nolabel="1" colspan="2"
                        domain="[('account_type', '=', 'asset_cash')]">
                        <list>
                            <field name="code" />
                            <field name="name" />
                            <field name="currency_id" />
                            <field name="company_ids" />
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>