<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_bank_form_view_inherit_exchange_rate" model="ir.ui.view">
        <field name="name">res.bank.form.view.inherit.exchange_rate</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_form" />
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='web_ribbon']" position="before">
                <div name="button_box" class="oe_button_box">
                    <button class="oe_stat_button" icon="fa-navicon" type="object"
                        name="open_bank_exchange_rate" string="Exchange Rate">
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>