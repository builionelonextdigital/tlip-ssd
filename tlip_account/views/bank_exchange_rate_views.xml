<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bank_exchange_rate_view_tree" model="ir.ui.view">
        <field name="name">bank.exchange.rate.view.tree</field>
        <field name="model">bank.exchange.rate</field>
        <field name="arch" type="xml">
            <list string="Bank Exchange Rate" editable="bottom">
                <field name="date" />
                <field name="bank_id" options="{'no_create': True, 'no_create_edit': True}" />
                <field name="currency_id" options="{'no_create': True, 'no_create_edit': True}" />
                <field name="selling_exchange_rate" />
                <field name="buying_exchange_rate" />
            </list>
        </field>
    </record>

    <record id="bank_exchange_rate_view_form" model="ir.ui.view">
        <field name="name">bank.exchange.rate.view.form</field>
        <field name="model">bank.exchange.rate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="date" />
                            <field name="bank_id"
                                options="{'no_create': True, 'no_create_edit': True}" />
                            <field name="currency_id"
                                options="{'no_create': True, 'no_create_edit': True}" />
                        </group>
                        <group>
                            <field name="selling_exchange_rate" />
                            <field name="buying_exchange_rate" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bank_exchange_rate_action" model="ir.actions.act_window">
        <field name="name">Bank Exchange Rate</field>
        <field name="res_model">bank.exchange.rate</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>