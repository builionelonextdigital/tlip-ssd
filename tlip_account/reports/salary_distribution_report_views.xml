<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="salary_distribution_report_view_tree" model="ir.ui.view">
            <field name="name">salary.distribution.report.view.list</field>
            <field name="model">salary.distribution.report</field>
            <field name="arch" type="xml">
                <list string="Salary Distribution Report" create="0" delete="0">
                    <field name="parent_category_id" optional="hide" />
                    <field name="category_id" />
                    <field name="oos_description" />
                    <field name="budget_code_id" />
                    <field name="credit_account_id" />
                    <field name="debit_account_id" />
                    <field name="item_code" />
                    <field name="item_name" />
                    <field name="company_id" optional="hide" />
                    <field name="currency_id" optional="hide" />
                    <field name="amount" sum="Total Amount" />
                </list>
            </field>
        </record>

        <record id="salary_distribution_report_view_search" model="ir.ui.view">
            <field name="name">salary.distribution.report.view.search</field>
            <field name="model">salary.distribution.report</field>
            <field name="arch" type="xml">
                <search string="Salary Distribution Report">
                    <field name="category_id" />
                    <field name="item_code" />
                    <field name="item_name" />
                    <field name="company_id" />
                    <field name="oos_description" />
                    <field name="budget_code_id" />
                    <separator />
                    <group expand="0" string="Group By">
                        <filter string="Parent Category" name="parent_category_id"
                            context="{'group_by':'parent_category_id'}" />
                        <filter string="Category" name="category_id"
                            context="{'group_by':'category_id'}" />
                        <separator />
                        <filter string="Item Code" name="item_code"
                            context="{'group_by':'item_code'}" />
                        <separator />
                        <filter string="Item Name" name="item_name"
                            context="{'group_by':'item_name'}" />
                        <separator />
                        <filter string="OOS Description" name="oos_description"
                            context="{'group_by':'oos_description'}" />
                        <separator />
                        <filter string="Budget Code" name="budget_code_id"
                            context="{'group_by':'budget_code_id'}" />
                        <separator />
                        <filter string="Credit Account" name="credit_account_id"
                            context="{'group_by':'credit_account_id'}" />
                        <filter string="Debit Account" name="debit_account_id"
                            context="{'group_by':'debit_account_id'}" />
                        <filter string="Company" name="company_id"
                            context="{'group_by':'company_id'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="salary_distribution_report_view_pivot" model="ir.ui.view">
            <field name="name">salary.distribution.report.view.pivot</field>
            <field name="model">salary.distribution.report</field>
            <field name="arch" type="xml">
                <pivot string="Salary Distribution Report">
                    <field name="category_id" type="row" />
                    <field name="oos_description" type="row" />
                    <field name="budget_code_id" type="row" />
                    <field name="debit_account_id" type="row" />
                    <field name="item_name" />
                    <field name="credit_account_id" type="col" />
                    <field name="amount" type="measure" />
                </pivot>
            </field>
        </record>

        <record id="salary_distribution_report_action" model="ir.actions.act_window">
            <field name="name">Salary Distribution Report</field>
            <field name="res_model">salary.distribution.report</field>
            <field name="view_mode">pivot,list</field>
            <field name="context">{"search_default_open_budget":1}</field>
        </record>

        <menuitem id="salary_distribution_report_menu" name="Salary Distribution Report"
            groups="account.group_account_readonly"
            parent="account.account_reports_management_menu"
            action="salary_distribution_report_action" />
    </data>
</odoo>
