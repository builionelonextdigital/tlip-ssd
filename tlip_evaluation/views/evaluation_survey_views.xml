<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_evaluation_survey_form" model="ir.ui.view">
        <field name="name">evaluation.survey.form</field>
        <field name="model">evaluation.survey</field>
        <field name="arch" type="xml">
            <form string="Evaluation Survey" create="0" delete="0">
                <header>
                    <button name="button_submit" type="object"
                        string="Submit" class="btn-primary"
                        invisible="state != 'draft'" />
                    <button name="button_cancel" type="object"
                        string="Cancel" class="btn-secondary"
                        invisible="state == 'cancel'" />
                    <button name="button_reset" type="object"
                        string="Reset" class="btn-secondary"
                        invisible="state != 'cancel'" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="evaluation_date" readonly="state != 'draft'" />
                            <field name="reviewer_id" options="{'no_create': 1}"
                                readonly="state != 'draft'" />
                            <field name="position_id" readonly="1" />
                            <field name="department_id" readonly="1" />
                            <field name="partner_id"
                                readonly="1" string="Supplier"
                                context="{'form_view_ref': 'tlip_base.view_tlip_base_partner_form_custom', 'partner_readonly': 1}" />
                        </group>
                        <group>
                            <field name="evaluation_type" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Evaluation">
                            <field name="survey_criteria_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="existing_criteria_ids" column_invisible="1" />
                                    <field name="evaluation_criteria_id"
                                        options="{'no_open': 1, 'no_create': 1}"
                                        domain="[('id', 'not in', existing_criteria_ids)]" />
                                    <field name="score" sum="Score" />
                                    <button name="action_open_questions" type="object"
                                        string="Open Questions"
                                        icon="fa-list-ul" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_evaluation_survey_tree" model="ir.ui.view">
        <field name="name">evaluation.survey.tree</field>
        <field name="model">evaluation.survey</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="evaluation_date" />
                <field name="reviewer_id" />
                <field name="position_id" />
                <field name="department_id" />
                <field name="partner_id"
                    string="Supplier" />
                <field name="evaluation_type" />
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'cancel'"
                    decoration-success="state == 'confirm'" />
            </list>
        </field>
    </record>

    <record id="evaluation_survey_action" model="ir.actions.act_window">
        <field name="name">Evaluation Survey</field>
        <field name="res_model">evaluation.survey</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'delete': False, 'create': False}</field>
    </record>
</odoo>
