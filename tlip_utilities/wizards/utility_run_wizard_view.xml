<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="utility_run_wizard_action" model="ir.actions.act_window">
        <field name="name">Run</field>
        <field name="res_model">utility.run.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="utility_run_wizard_view_form" model="ir.ui.view">
        <field name="name">utility_run_wizard.view.form</field>
        <field name="model">utility.run.wizard</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <label for="date_from" string="Period" />
                            <div class="o_row">
                                <field name="date_from" nolabel="1" />
                                <span class="fa fa-arrow-right" title="Arrow Right"/>
                                <field name="date_to" nolabel="1" />
                            </div>
                            <field name="utility_type" widget="radio" options="{'horizontal': true}" />
                            <field name="electricity_point_id" invisible="utility_type != 'electric'" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                            <field name="water_point_id" invisible="utility_type != 'water'" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="run" string="Run" type="object" class="btn btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
