<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_electricity">
            <field name="name">Electricity</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_electricity_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_electricity"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_electricity_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="implied_ids" eval="[(4, ref('tlip_utilities.group_electricity_user'))]"/>
            <field name="category_id" ref="module_category_electricity" />
            <field
                name="users"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>

        <record model="ir.module.category" id="module_category_water">
            <field name="name">Water</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_water_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_water"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_water_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="implied_ids" eval="[(4, ref('tlip_utilities.group_water_user'))]"/>
            <field name="category_id" ref="module_category_water" />
            <field
                name="users"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>
    </data>
</odoo>