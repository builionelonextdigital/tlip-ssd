<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="electricity_kfactor_view_tree" model="ir.ui.view">
        <field name="name">electricity.kfactor.view.tree</field>
        <field name="model">electricity.kfactor</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="kfactor" />
                <field name="cosphi" />
            </list>
        </field>
    </record>

    <record id="action_utilities_electricity_kfactor_view" model="ir.actions.act_window">
        <field name="name">Electricity K-factor</field>
        <field name="res_model">electricity.kfactor</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>