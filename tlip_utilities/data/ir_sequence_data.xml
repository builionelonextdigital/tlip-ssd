<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="electricity_consumption_sequence" model="ir.sequence">
        <field name="name">Electricity Consumption Sequence</field>
        <field name="code">electricity.consumption.sequence</field>
        <field name="prefix">EC</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="active" eval="True" />
    </record>

    <record id="water_consumption_sequence" model="ir.sequence">
        <field name="name">water Consumption Sequence</field>
        <field name="code">water.consumption.sequence</field>
        <field name="prefix">WC</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="active" eval="True" />
    </record>
</odoo>