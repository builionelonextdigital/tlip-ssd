<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sync_electricity_consumption" model="ir.cron">
            <field name="name">Synchronize Electricity Consumption</field>
            <field name="model_id" ref="tlip_utilities.model_electricity_point" />
            <field name="state">code</field>
            <field name="code">model._synchronize_consumption()</field>
            <field name="active">True</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
        <record id="ir_cron_sync_water_consumption" model="ir.cron">
            <field name="name">Synchronize Water Consumption</field>
            <field name="model_id" ref="tlip_utilities.model_water_point" />
            <field name="state">code</field>
            <field name="code">model._synchronize_consumption()</field>
            <field name="active">True</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>