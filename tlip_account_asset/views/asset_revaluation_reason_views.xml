<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="asset_revaluation_reason_view_tree" model="ir.ui.view">
        <field name="name">asset.revaluation.reason.view.tree</field>
        <field name="model">asset.revaluation.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="type" />
            </list>
        </field>
    </record>

    <record id="asset_revaluation_reason_action" model="ir.actions.act_window">
        <field name="name">Asset Revaluation Reason</field>
        <field name="res_model">asset.revaluation.reason</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem parent="account.account_management_menu"
        id="menu_action_asset_revaluation_reason" action="asset_revaluation_reason_action"
        sequence="100" groups="account.group_account_readonly" />

</odoo>