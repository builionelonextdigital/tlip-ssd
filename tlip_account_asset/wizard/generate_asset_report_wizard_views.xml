<?xml version="1.0"?>
<odoo>

    <record id="generate_asset_report_wizard_form_view" model="ir.ui.view">
        <field name="name">generate.asset.report.wizard.form.view</field>
        <field name="model">generate.asset.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Asset Report">
                <sheet>
                    <group>
                        <group>
                            <field name="report" invisible="1" />
                            <field name="binary_file" filename="filename"
                                invisible="not filename" readonly="1"/>
                            <field name="filename" invisible="1" />
                            <label for="month" string="Month/Year"
                                invisible="filename" />
                            <div class="o_row" invisible="filename">
                                <field name="month" placeholder="Month" class="oe_inline"
                                />
                                <span class="oe_inline">/</span>
                                <field name="year" placeholder="Year" class="oe_inline"
                                />
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" string="Generate"
                        type="object" class="btn-primary" invisible="filename" />
                    <button string="Close" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="action_generate_allocation_equipment_expenses_report" model="ir.actions.act_window">
        <field name="name">Allocation of Equipment and Prepaid Expense</field>
        <field name="res_model">generate.asset.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_report': 'allocation_equipment_expenses'}</field>
        <field name="target">new</field>
    </record>

    <record
        id="action_generate_depreciation_fixed_assets_report" model="ir.actions.act_window">
        <field name="name">Depreciation for Fixed Assets</field>
        <field name="res_model">generate.asset.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_report': 'depreciation_fixed_assets'}</field>
        <field name="target">new</field>
    </record>

    <record
        id="action_generate_fixed_assets_registration_report" model="ir.actions.act_window">
        <field name="name">Fixed Asset Registration</field>
        <field name="res_model">generate.asset.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_report': 'fixed_assets_registration'}</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="account_assets_reports_menu" name="Assets Reports" sequence="10"
        groups="account.group_account_readonly" parent="account.menu_finance_reports">
        <menuitem id="menu_action_assets_allocation_equipment_expenses_report"
            name="Allocation of Equipment and Prepaid Expense"
            action="action_generate_allocation_equipment_expenses_report" sequence="1" />
        <menuitem id="menu_depreciation_fixed_assets_report"
            name="Depreciation for Fixed Assets"
            action="action_generate_depreciation_fixed_assets_report" sequence="2" />
        <menuitem id="menu_fixed_assets_registration_report"
            name="Fixed Asset Registration"
            action="action_generate_fixed_assets_registration_report" sequence="3" />
    </menuitem>
</odoo>