<odoo>
    <!-- Wizard Form View -->
    <record id="view_fx_out_calc_ut_wizard" model="ir.ui.view">
        <field name="name">fx.out.calc.ut.wizard.form</field>
        <field name="model">fx.out.calc.ut.wizard</field>
        <field name="arch" type="xml">
            <form string="Calculate FX Out UT">
                <group>
                    <field name="date"/>
                    <field name="journal_id"/>
                    <field name="currency_id"/>
                </group>
                <footer>
                    <button name="action_calculate" string="Calculate" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_fx_out_calc_ut_wizard" model="ir.actions.act_window">
        <field name="name">Calculate FX Out UT</field>
        <field name="res_model">fx.out.calc.ut.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fx_out_calc_ut_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
