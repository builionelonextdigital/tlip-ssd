<odoo>
    <record id="view_fx_out_close_month_wizard" model="ir.ui.view">
        <field name="name">fx.out.close.month.wizard.form</field>
        <field name="model">fx.out.close.month.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Month - FX Out">
                <group>
                    <field name="month"/>
                    <field name="journal_id"/>
                    <field name="currency_id"/>
                </group>
                <footer>
                    <button string="Run Closing" type="object" name="action_close" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fx_out_close_month_wizard" model="ir.actions.act_window">
        <field name="name">Close Month - FX Out</field>
        <field name="res_model">fx.out.close.month.wizard</field>
        <field name="view_id" ref="view_fx_out_close_month_wizard"/>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
