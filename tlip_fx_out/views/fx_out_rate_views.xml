<odoo>
    <record id="view_fx_out_rate_tree" model="ir.ui.view">
        <field name="name">fx.out.rate.tree</field>
        <field name="model">account.fx.out.rate</field>
        <field name="arch" type="xml">
            <list string="FX Out Daily Rates">
                <field name="date"/>
                <field name="company_id" readonly="1"/>
                <field name="currency_id" readonly="1"/>
                <field name="fx_out_ut" readonly="1"/>
                <field name="fx_out_ok" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_fx_out_rate_form" model="ir.ui.view">
        <field name="name">fx.out.rate.form</field>
        <field name="model">account.fx.out.rate</field>
        <field name="arch" type="xml">
            <form string="FX Out Rate">
                <group>
                    <group>
                        <field name="date"/>
                        <field name="company_id" readonly="1"/>
                        <field name="currency_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="fx_out_ut" readonly="1"/>
                        <field name="fx_out_ok" readonly="1"/>
                        <field name="temp_amount_residual" readonly="1"/>
                        <field name="temp_amount_residual_currency" readonly="1"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="action_fx_out_rate" model="ir.actions.act_window">
        <field name="name">FX Out Rates</field>
        <field name="res_model">account.fx.out.rate</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_fx_out_rate_tree"/>
    </record>
</odoo>
