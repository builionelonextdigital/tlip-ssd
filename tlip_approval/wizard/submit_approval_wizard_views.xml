<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="submit_approval_wizard_form" model="ir.ui.view">
            <field name="name">Submit Approval</field>
            <field name="model">submit.approval.wizard</field>
            <field name="arch" type="xml">
                <form string="Submit Approval">
                    <div class="oe_title" invisible="1">
                        <label for="name" />
                        <h2>
                            <field name="name" />
                        </h2>
                    </div>
                    <field name="related_res_id" invisible="1" />
                    <field name="category_option_id" invisible="1" />
                    <field name="category_id" invisible="1" />
                    <field name="identify_key" invisible="1" />
                    <label for="description" />
                    <field name="description" widget="html" />
                    <footer>
                        <button string="Submit" class="btn-primary" name="action_submit_approval"
                            type="object" />
                        <button string="Discard" special="cancel" data-hotkey="z" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>