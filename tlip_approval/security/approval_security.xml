<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <!-- Regular User -->
        <record id="approvals.approval_request_request_approver_rule" model="ir.rule">
            <field name="name">Approval Request: request approver rule</field>
            <field name="model_id" ref="model_approval_request" />
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="0" />
            <field name="domain_force">['|', '|', '|',
                ('request_owner_id', '=', user.id),
                ('approver_ids.user_id','=', user.id),
                '&amp;', ('approver_ids.job_id','!=', False),
                ('approver_ids.job_id','=', user.employee_id.job_id.id),
                '&amp;',
                ('category_id.manager_approval', 'in', ['approver', 'required']),
                ('request_owner_id.parent_id.user_id', '=', user.id)]</field>
        </record>

        <record id="approvals.approval_approver_user_change_own" model="ir.rule">
            <field name="name">Approval Approver: change own</field>
            <field name="model_id" ref="model_approval_approver" />
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="0" />
            <field name="perm_unlink" eval="0" />
            <field name="domain_force">['|', '|', ('request_id.request_status', '=', 'approved'), ('user_id', '=', user.id), ('job_id','=',
                user.employee_id.job_id.id)]</field>
        </record>

    </data>

    <function model="ir.rule" name="write">
        <value eval="[ref('approvals.approval_request_request_approver_rule')]" />
        <value
            eval="{'domain_force': '''[\'|\', \'|\', \'|\',
                (\'request_owner_id\', \'=\', user.id),
                (\'approver_ids.user_id\',\'=\', user.id),
                (\'approver_ids.job_id\',\'=\', user.employee_id.job_id.id),
                \'&amp;\',
                (\'category_id.manager_approval\', \'in\', [\'approver\', \'required\']),
                (\'request_owner_id.parent_id.user_id\', \'=\', user.id)]'''}" />
    </function>
    <function model="ir.rule" name="write">
        <value eval="[ref('approvals.approval_approver_user_read_own')]" />
        <value
            eval="{'domain_force': '''[\'|\', \'|\',
                (\'request_id.request_owner_id\', \'=\', user.id),
                (\'user_id\', \'=\', user.id),
                (\'job_id\',\'=\', user.employee_id.job_id.id)]'''}" />
    </function>
    <function model="ir.rule" name="write">
        <value eval="[ref('approvals.approval_approver_user_change_own')]" />
        <value
            eval="{'domain_force': '[\'|\', (\'user_id\', \'=\', user.id), (\'job_id\',\'=\',user.employee_id.job_id.id)]'}" />
    </function>
</odoo>