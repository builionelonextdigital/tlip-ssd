<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record model="ir.rule" id="procurement_task_multi_comp_rule">
        <field name="name">Procurement Task Multi-company rule</field>
        <field name="model_id" ref="model_procurement_task" />
        <field name="domain_force">['|',('company_id','=',False),('company_id','parent_of',
            company_ids)]</field>
    </record>

    <record model="ir.rule" id="request_purchase_multi_comp_rule">
        <field name="name">Procurement Request Multi-company rule</field>
        <field name="model_id" ref="model_request_purchase" />
        <field name="domain_force">['|',('company_id','=',False),('company_id','parent_of',
            company_ids)]</field>
    </record>

    <record model="ir.rule" id="request_purchase_line_multi_comp_rule">
        <field name="name">Procurement Request Line Multi-company rule</field>
        <field name="model_id" ref="model_request_purchase_line" />
        <field name="domain_force">['|',('company_id','=',False),('company_id','parent_of',
            company_ids)]</field>
    </record>

    <record model="ir.rule" id="purchase_supplement_comp_rule">
        <field name="name">Purchase Supplement multi-company</field>
        <field name="model_id" ref="model_purchase_supplement" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>