<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="contract_sign_rule_view_tree" model="ir.ui.view">
        <field name="name">contract.sign.rule.view.tree</field>
        <field name="model">contract.sign.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="job_ids" widget="many2many_tags"
                    options="{'no_create': True, 'no_create_edit': True}" />
                <field name="contract_amount" />
            </list>
        </field>
    </record>

    <record id="contract_sign_rule_action" model="ir.actions.act_window">
        <field name="name">Contract Signature Rules</field>
        <field name="res_model">contract.sign.rule</field>
        <field name="view_mode">list</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
