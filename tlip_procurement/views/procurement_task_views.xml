<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="procurement_task_view_form" model="ir.ui.view">
        <field name="name">procurement.task.view.form</field>
        <field name="model">procurement.task</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="show_preference_check" invisible="1" />
                    <field name='po_ids' invisible="1" />
                    <field name='request_type' invisible="1" />
                    <field name='is_locked' invisible="1" />
                    <button name="action_confirm" string="Mark as Todo" type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                        confirm="Are you sure that you want to do this action?" />
                    <button name="action_create_rfqs" string="Create RFQ" type="object"
                        class="btn-primary"
                        invisible="state != 'in_progress' or rfq_selection_ids"
                        confirm="Are you sure that you want to do this action?" />
                    <button name="action_approve_request" type="object" string="Approve"
                        invisible="user_status != 'pending' or state != 'vendor_selection'" class="btn-primary" data-hotkey="v"
                        confirm="Are you sure that you want to do this action?" />
                    <button name="action_reject_request" string="Refuse" type="object"
                        invisible="user_status != 'pending' or state != 'vendor_selection'" data-hotkey="z"
                        confirm="Are you sure that you want to do this action?" />
                    <button name="action_create_purchase_order" class="btn-primary" string="New Order" type="object"
                        confirm="Are you sure that you want to do this action?"
                        invisible="state != 'approved' or current_contract_id or count_po" />
                    <button name="action_reset" string="Reset" type="object"
                        confirm="Are you sure that you want to do this action?"
                        class="btn-primary"
                        invisible="state not in ('rejected', 'withdrawn')" />
                    <button name="action_withdraw_approval" string="Withdraw" type="object" class="btn btn-secondary"
                        confirm="Are you sure that you want to do this action?"
                        invisible="state in ('approved', 'rejected', 'canceled', 'withdrawn')" />
                    <button name="button_cancel" string="Cancel" type="object"
                        class="btn btn-secondary"
                        invisible="state not in ('rejected', 'withdrawn')"
                        confirm="Are you sure that you want to do this action?" />
                    <widget name="attach_document" string="Attach Document" action="message_post"
                        invisible="state != 'draft'" />
                    <button name="action_lock_budget" type="object" string="Lock"
                        invisible="is_locked or state != 'approved' or current_contract_id"
                        groups="tlip_procurement.group_tlip_lock_contract"
                        confirm="Are you sure that you want to do this action?" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,in_progress,vendor_selection,approved" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_rfqs"
                            invisible="not rfq_selection_ids"
                            icon="fa-list">
                            <field name="count_rfq" widget="statinfo" string="RFQs" />
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_purchase_orders"
                            invisible="state not in ('approved', 'done') or current_contract_id"
                            icon="fa-list">
                            <field name="count_po" widget="statinfo" string="Orders" />
                        </button>
                        <button class="oe_stat_button" type="object"
                            name="action_preview_vendor_evaluation"
                            invisible="not rfq_selection_ids" icon="fa-list">
                            <field name="count_rfq_selections" widget="statinfo" string="Comparison" />
                        </button>
                        <button class="oe_stat_button" name="action_view_requisition_agreements"
                            type="object" invisible="not current_contract_id"
                            icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">
                                    Procurement Contract
                                </span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Locked" bg_color="text-bg-danger" invisible="not is_locked or not current_contract_id"/>
                    <div class="oe_title">
                        <span class="o_form_label">Procurement Task</span>
                        <h1 class="d-flex">
                            <field name="priority" widget="priority" class="me-3" />
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="select_bidding" readonly="1"
                                widget="radio" options="{'horizontal': true}"
                                invisible="not select_bidding" />
                            <field name="non_bidding_reason"
                                required="select_bidding == 'non_bidding' and request_type != 'special'"
                                readonly="1" invisible="select_bidding != 'non_bidding' or request_type == 'special'" />
                            <field name="user_id" required="1"
                                options="{'no_create': True}"
                                readonly="state != 'draft'" domain="[('id', 'in', procurement_user_ids)]"/>
                            <field name="procurement_user_ids" invisible="1"/>
                            <field name="date_order" required="1" readonly="state != 'draft'" />
                            <field name="date_planned" required="1" readonly="state != 'draft'" />
                            <field name="notes" required="1" readonly="state != 'draft'" />
                            <field name="cancel_reason" invisible="state != 'canceled'" readonly="1" />
                        </group>
                        <group>
                            <field name="vendor_ids"
                                readonly="state not in ['draft', 'in_progress']"
                                widget="many2many_tags"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" />
                            <field name="purchase_contract_type_id" required="1"
                                readonly="state not in ['draft', 'in_progress']"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" />
                            <field name="is_advance_enabled" readonly="state not in ['draft', 'in_progress']" />
                            <field name="bypass_vendor_selection_rule" readonly="state not in ['draft', 'in_progress']" />
                            <field name="budget_department_responsible_id" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="request_items" string="Request Items">
                            <field name="request_line_ids"
                                readonly="state not in ['draft', 'in_progress'] or po_ids">
                                <list editable="bottom" mode="list" create="0" delete="0">
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="company_id" column_invisible="1" />
                                    <field name="required_project" column_invisible="1"/>
                                    <field name="product_id" options='{"no_create": True}'
                                        domain="[('categ_id', '=', product_categ_id)]" />
                                    <field name="product_categ_id" readonly="1" />
                                    <field name="description" readonly="0" />
                                    <field name="project_id" readonly="1"
                                    required="required_project"
                                        options='{"no_open": True}' />
                                    <field name="development_phase_id" readonly="1"
                                        options='{"no_open": True}' />
                                    <field name="qty_demand" readonly="1" />
                                    <field name="price_unit" readonly="1" />
                                    <field name="product_uom_id" readonly="1"
                                        options='{"no_create": True}'
                                        force_save="1"
                                        groups="uom.group_uom" />
                                    <field name="price_total" />
                                    <field name="analytic_account_id" readonly="1"
                                        options='{"no_open": True}' />
                                    <field name="budget_department_id" readonly="1" />
                                    <field name="request_id" readonly="1"
                                        string="Source Document" />
                                </list>
                            </field>
                        </page>
                        <page name="rfq_selection" string="Proposed RFQ's"
                            invisible="not rfq_selection_ids">
                            <field name="confirmed_selection_id" invisible="1" />
                            <field name="rfq_selection_ids" readonly="1">
                                <list editable="bottom" mode="list">
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="task_id" column_invisible="1" />
                                    <field name="po_id" />
                                    <field name="vendor_id" />
                                    <field name="amount_untaxed" />
                                    <field name="bypass_contract" />
                                    <field name="reason" />
                                    <field name="state" />
                                    <field name="history_approvals_count" column_invisible="1" />
                                    <button name="button_confirm_order_selection"
                                        string="Confirm" class="btn-link"
                                        invisible="state != 'waiting_confirm'"
                                        type="object" />
                                    <button name="action_reset_approval" string="Reset Approval"
                                        type="object"
                                        invisible="state != 'rejected'" />
                                    <button name="action_open_approval_history_ids"
                                        type="object"
                                        invisible="history_approvals_count == 0"
                                        icon="fa-history">
                                    </button>
                                </list>
                            </field>
                        </page>
                        <page string="General Requirements" name="general_requirement"
                            invisible="select_bidding != 'bidding'">
                            <field name="requirement_line_ids" mode="list"
                                readonly="state != 'draft'">
                                <list editable="bottom" no_open="1">
                                    <field name="name" required="1" />
                                    <field name="description" />
                                    <field name="vendor_comment" />
                                </list>
                            </field>
                        </page>
                        <page string="Approver(s)" name="approver"
                            invisible="state in ('draft', 'in_progress', 'canceled')">
                            <field name="approver_ids" mode="list" readonly="1">
                                <list editable="bottom" decoration-success="status=='approved'"
                                    decoration-warning="status in ['pending', 'waiting']"
                                    decoration-danger="status=='refused'" no_open="1">
                                    <field name="existing_request_user_ids" column_invisible="True" />
                                    <field name="sequence" column_invisible="True" />
                                    <field name="user_id" string="Approver"
                                        required="not job_id" />
                                    <field name="job_id" required="not user_id" />
                                    <field name="status" />
                                    <field name="company_id" column_invisible="True" />
                                </list>
                            </field>
                        </page>
                        <page string="Checklist" name="checklist"
                            invisible="state not in ['vendor_selection', 'contract_review']">
                            <field name="checklist" />
                        </page>
                        <page string="Preference Check" name="preference_check"
                            invisible="not show_preference_check">
                            <group>
                                <group>
                                    <field name="fs_annual_sales" widget="monetary"
                                        string="Upto date FS information: Annual Sales" />
                                    <field name="fs_annual_pat" widget="monetary"
                                        string="Upto date FS information: Annual PAT" />
                                    <field name="fs_total_assets" widget="monetary"
                                        string="Upto date FS information: Total Assets" />
                                    <field name="copy_fs_file"
                                        filename="copy_fs_filename" />
                                    <field name="copy_fs_filename"
                                        invisible="1" />
                                    <field name="copy_client_file" filename="copy_client_filename" />
                                    <field name="copy_client_filename"
                                        invisible="1" />
                                    <field name="site_check_file" filename="site_check_filename" />
                                    <field name="result_site_check" />
                                    <field name="site_check_filename"
                                        invisible="1" />
                                    <field name="other_notes" />
                                    <field name="currency_id" invisible="1" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="procurement_assign_task_view_form" model="ir.ui.view">
        <field name="name">procurement.assign.task.view.form</field>
        <field name="model">procurement.task</field>
        <field name="arch" type="xml">
            <form string="Assign Task">
                <sheet>
                    <group>
                        <group>
                            <field name="select_bidding"
                                widget="radio" options="{'horizontal': true}"
                                invisible="context.get('hidden_bidding')"
                                required="not context.get('hidden_bidding')" />
                            <field name="non_bidding_reason"
                                required="select_bidding == 'non_bidding'"
                                invisible="context.get('hidden_bidding') or select_bidding != 'non_bidding'" />
                            <field name="user_id" required="1"
                                options="{'no_create': True}"
                                domain="[('id', 'in', procurement_user_ids), ('company_id', 'in', [company_id, False])]"/>
                            <field name="company_id" invisible="1"/>
                            <field name="procurement_user_ids" invisible="1"/>
                            <field name="date_order" required="1" />
                            <field name="date_planned" required="1" />
                            <field name="notes" required="1" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" name="action_save_view_assign_task" type="object"
                        class="btn-primary" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="procurement_task_cancel_reason_view_form" model="ir.ui.view">
        <field name="name">procurement.task.cancel.reason.view.form</field>
        <field name="model">procurement.task</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <p class="text-danger">IMPORTANT: Are you sure you want to cancel this task? Once cancelled, the task cannot be reactivated.</p>
                        <field name="cancel_reason" required="1" string="Reason" />
                    </group>
                </sheet>
                <footer>
                    <button string="Cancel" name="action_cancel" type="object" class="btn-primary" confirm="Are you sure that you want to do this action?" />
                    <button string="Close" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="procurement_task_view_tree" model="ir.ui.view">
        <field name="name">procurement.task.view.tree</field>
        <field name="model">procurement.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="priority" optional="show" widget="priority" nolabel="1" />
                <field name="name" string="Reference" />
                <field name="user_id" />
                <field name="amount_total" string="Total Amount" />
                <field name="notes" string="Description" />
                <field name="state" widget="badge"
                    decoration-danger="state == 'rejected'"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'wait_for_approval'"
                    decoration-success="state == 'approved'" />
            </list>
        </field>
    </record>

    <record id="procurement_task_view_search" model="ir.ui.view">
        <field name="name">procurement.task.view.search</field>
        <field name="model">procurement.task</field>
        <field name="arch" type="xml">
            <search>
                <group expand="0" string="Group By">
                    <filter name="filter_approvals_to_review" string="My Approvals to Review"
                        domain="[('state', '=', 'vendor_selection'), '|', ('current_approver_id.job_id.employee_ids.user_id', 'in', [uid]), ('current_approver_id.user_id', '=', uid)]" />
                    <filter string="Request Type" name="groupby_request_type"
                    context="{'group_by': 'request_type'}" />
                    <filter string="Applicant" name="groupby_user"
                    context="{'group_by': 'user_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="procurement_task_action" model="ir.actions.act_window">
        <field name="name">Procurement Tasks</field>
        <field name="res_model">procurement.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'create': 0, 'delete': 0, 'search_default_groupby_request_type': 1}</field>
    </record>

</odoo>
