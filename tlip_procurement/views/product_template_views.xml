<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_for_view_inherit_tlip_procurement" model="ir.ui.view">
        <field name="name">product.template.product.form.tlip.procurement</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="type" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="is_storable" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="purchase.product_normal_action_puchased" model="ir.actions.act_window">
        <field name="context">{"search_default_filter_to_purchase":1, "purchase_product_template": 1, "default_type": "consu", "default_is_storable": True}</field>
        <field name="domain">[('purchase_ok', '=', True)]</field>
    </record>
</odoo>
