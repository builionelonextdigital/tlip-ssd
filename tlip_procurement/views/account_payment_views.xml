<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">tlip.request.account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="tlip_account.view_account_payment_form" />
        <field name="arch" type="xml">
            <field name="development_phase_id" position="before">
                <field name="purchase_order_id" required="is_request_payment" invisible="not purchase_order_id"/>
                <field name="procurement_contract_id" invisible="not procurement_contract_id"/>
                <field name="task_id" invisible="not task_id"/>
                <field name="budget_department_responsible_job_id" invisible="1" />
            </field>
            <notebook position="inside">
                <page name="order_lines" string="Request Items" invisible="not request_line_ids">
                    <field name="request_line_ids" nolabel="1">
                        <list>
                            <field name="currency_id" column_invisible="1" />
                            <field name="contract_currency_id" column_invisible="1" />
                            <field name="company_id" column_invisible="1" />
                            <field name="product_id" options='{"no_create": True}'/>
                            <field name="product_categ_id" readonly="1" />
                            <field name="description" readonly="1" />
                            <field name="project_id" readonly="1"
                                options='{"no_open": True}' />
                            <field name="development_phase_id" readonly="1"
                                options='{"no_open": True}' />
                            <field name="qty_demand" readonly="1" />
                            <field name="contract_total" string="Total"
                                options="{'currency_field': 'contract_currency_id'}"/>
                            <field name="analytic_account_id" readonly="1"
                                options='{"no_open": True}' />
                            <field name="budget_department_id" readonly="1" />
                            <field name="request_id" readonly="1"
                                string="Source Document" />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_payment_request_payment_form" model="ir.ui.view">
        <field name="name">view_payment_request_payment_form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="tlip_account.view_payment_request_payment_form"/>
        <field name="arch" type="xml">
            <field name="foreign_currency_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <page name="contract_info" position="attributes">
                <attribute name="invisible">purchase_order_id</attribute>
            </page>
        </field>
    </record>
</odoo>
