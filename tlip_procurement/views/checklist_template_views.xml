<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="checklist_template_view_tree" model="ir.ui.view">
        <field name="name">checklist.template.view.tree</field>
        <field name="model">checklist.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="related_model_id" />
                <field name="related_model_name" column_invisible="1" />
                <field name="condition" widget="domain" options="{'model': 'related_model_name'}" />
                <field name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'confirm'"
                    decoration-muted="state == 'cancel'" />
            </list>
        </field>
    </record>

    <record id="checklist_template_view_form" model="ir.ui.view">
        <field name="name">checklist.template.view.form</field>
        <field name="model">checklist.template</field>
        <field name="arch" type="xml">
            <form string="Checklist Template">
                <header>
                    <field name="state" widget="statusbar" />
                    <button name="action_confirm" string="Confirm" type="object"
                        confirm="Are you sure that you want to do this action?"
                        class="oe_highlight" invisible="state != 'draft'" />
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state == 'cancel'"
                        confirm="Are you sure that you want to do this action?" />
                    <button name="action_reset" string="Reset to Draft" type="object"
                        confirm="Are you sure that you want to do this action?"
                        invisible="state == 'draft'" />
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="state != 'draft'" />
                        <field name="related_model_id"
                            readonly="state != 'draft'"
                            options="{'no_create': True, 'no_create_edit': True}" />
                        <field name="related_model_name" invisible="1" />
                        <field name="condition" widget="domain"
                            readonly="state != 'draft'"
                            options="{'model': 'related_model_name'}" />
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="description" widget="html" readonly="state != 'draft'" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_checklist_template_view" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">checklist.template</field>
        <field name="view_mode">list</field>
        <field name="domain">[]</field>
        <field name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('checklist_template_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('checklist_template_view_form')})]" />
    </record>

</odoo>
