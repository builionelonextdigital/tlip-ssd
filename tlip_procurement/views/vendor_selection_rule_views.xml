<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="vendor_selection_rule_view_tree" model="ir.ui.view">
        <field name="name">vendor.selection.rule.view.tree</field>
        <field name="model">vendor.selection.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="currency_id" column_invisible="1" />
                <field name="is_maximum_infinity" column_invisible="1" />
                <field name="minimum_amount" />
                <field name="maximum_amount" />
                <field name="minimum_selected_vendors" />
            </list>
        </field>
    </record>

    <record id="vendor_selection_rule_action" model="ir.actions.act_window">
        <field name="name">Vendor Selection Rules</field>
        <field name="res_model">vendor.selection.rule</field>
        <field name="view_mode">list</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
