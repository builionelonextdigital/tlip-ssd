<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="request_purchase_line_view_form" model="ir.ui.view">
        <field name="name">request.purchase.line.view.form</field>
        <field name="model">request.purchase.line</field>
        <field name="arch" type="xml">
            <form edit="0" create="0">
                <sheet>
                    <group invisible="1">
                        <field name="currency_id" />
                        <field name="request_id" />
                        <field name="company_id" />
                    </group>
                    <group>
                        <group>
                            <field name="product_id" />
                            <field name="product_categ_id" />
                            <field name="qty_demand" />
                            <field name="price_unit" />
                            <field name='available_product_uom_ids' invisble='1' />
                            <field name="product_uom_id" domain="[('id', 'in', available_product_uom_ids)]"/>
                        </group>
                        <group>
                            <field name="analytic_account_id" />
                            <field name="price_total" />
                            <field name="description" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="request_purchase_line_view_tree" model="ir.ui.view">
        <field name="name">request.purchase.line.view.tree</field>
        <field name="model">request.purchase.line</field>
        <field eval="10" name="priority"/>
        <field name="arch" type="xml">
            <list name="request_purchase_line" string="Procurement Collection"  create="false" edit="true" expand="context.get('expand', False)" multi_edit="1">
                <header>
                   <button name="action_assign_procurement_task" type="object" string="Create Task" />
                   <button name="action_suggest_group_procurement_task" type="object" string="Suggest Group" column_invisible="context.get('search_default_group_by_matching', False)"/>
                </header>
                <field name="currency_id" column_invisible="1" />
                <field name="company_id" column_invisible="1"/>
                <field name="product_id" readonly="1" />
                <field name="user_id" readonly="1" />
                <field name="request_type" readonly="1"/>
                <field name="product_categ_id" readonly="1" />
                <field name="request_id" readonly="1" />
                <field name="task_id" readonly="1" />
                <field name="description" readonly="1" />
                <field name="qty_demand" string="Quantity" readonly="1" />
                <field name="price_unit" readonly="1" />
                <field name="product_uom_id" readonly="1" />
                <field name="price_total" string="Total" readonly="1" />
                <field name="state" widget="badge"
                    decoration-danger="state == 'rejected'"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'wait_for_approval'"
                    decoration-success="state == 'approved'" />
            </list>
        </field>
    </record>

    <record id="request_purchase_line_view_search" model="ir.ui.view">
        <field name="name">request.purchase.line.view.search</field>
        <field name="model">request.purchase.line</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="product_id" />
                <field name="product_categ_id" />
                <field name="budget_department_id" />
                <filter name="filter_await_procurement" string="Need to procurement" domain="[('task_id', '=', False), ('state', '=', 'approved')]"/>
                <separator/>
                <filter name="order_date" string="Order Date" date="date_order"/>
                <group expand="0" string="Group By">
                    <filter string="Matching" name="group_by_matching" domain="[]" context="{'group_by': 'matching_number'}"/>
                    <filter string="Product Category" name="group_by_category" domain="[]" context="{'group_by': 'product_categ_id'}"/>
                    <filter string="Department Group" name="group_by_budget_department_group" domain="[]" context="{'group_by': 'budget_department_group_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="request_procurement_collection_action" model="ir.actions.act_window">
        <field name="name">Procurement Collection</field>
        <field name="res_model">request.purchase.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="request_purchase_line_view_tree"/>
        <field name="domain">[('state', '=', 'approved'), ('request_id.category', '!=', 'entertainment'),'|', ('request_id.select_bidding', '=', 'non_bidding'), ('request_id.request_type', '=', 'normal')]</field>
        <field name="context">{'search_default_filter_await_procurement': 1}</field>
    </record>
</odoo>
