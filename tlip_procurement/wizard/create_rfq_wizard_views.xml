<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="create_rfq_wizard_view_form" model="ir.ui.view">
        <field name="name">create.rfq.wizard.view.form</field>
        <field name="model">create.rfq.wizard</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="task_id" invisible="1" />
                            <field name="existing_vendor_ids" invisible="1" />
                            <field name="vendor_ids"
                                widget="many2many_tags"
                                options="{'no_create': True, 'no_open': True}" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" class="btn-primary"
                        name="action_create_rfqs" type="object" />
                    <button string="Cancel" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>

</odoo>