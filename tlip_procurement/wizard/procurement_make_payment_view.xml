<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_procurement_make_payment" model="ir.ui.view">
        <field name="name">Request for Payment</field>
        <field name="model">procurement.make.payment</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="purchase_order_id" invisible="1"/>
                    <field name="type" string="Options"
                        class="oe_inline" widget="radio" />
                    <field name="available_bill_ids" invisible="1" />
                    <field name="bill_ids"
                        invisible="type != 'bill_payment'"
                        domain="[('id', 'in', available_bill_ids),('state', '=', 'posted')]" 
                        widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                        string="Confirm"
                        class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
