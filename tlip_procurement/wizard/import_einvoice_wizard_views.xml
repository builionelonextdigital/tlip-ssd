<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_einvoice_wizard_form" model="ir.ui.view">
        <field name="name">import.einvoice.wizard.form</field>
        <field name="model">import.einvoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Import E-Invoice Lines">
                <field name="move_id" invisible="1" />
                <p class="text-muted">You can download the sample import template: <a
                        target="_blank"
                        href="/tlip_procurement/static/import_templates/e_invoice_import_template.xlsx">
                    Template.xlsx</a></p>
                <group>
                    <group>
                        <field name="file" widget="binary" filename="filename"
                               help="Upload an Excel file (.xlsx). Each row represents one E-Invoice line." />
                        <field name="filename" invisible="1" />
                    </group>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
