<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stamp_final_contract_wizard_form_view" model="ir.ui.view">
        <field name="name">stamp.final.contract.wizard.form</field>
        <field name="model">stamp.final.contract.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">
                    Upload a new contract file with final approver's signature. The original contract file will be replaced with the new one after confirmation.
                </div>
                <group>
                    <group>
                        <field name="requisition_id" invisible="1"/>
                        <field name="final_contract" invisible="1"/>
                        <field name="new_contract_filename" invisible="1"/>
                        <field name="new_contract_file" widget="binary" filename="new_contract_filename" options="{'accepted_file_extensions': '.pdf'}" />
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                        string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
