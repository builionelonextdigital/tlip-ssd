<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_vendor_evaluation_form">
        <t t-call="web.basic_layout">
            <style>
                table { 
                    page-break-inside: auto;
                }
                tr {
                    page-break-inside:avoid;
                    page-break-after: auto;
                }
                .table-bordered table, th, td {
                    border: 1px solid black !important;
                }
                .table-bordered.rfq_comparison td {
                    vertical-align: middle;
                }
                ul.dash {
                    list-style: none;
                    margin-left: 0;
                    padding-left: 1em;
                }
                ul.dash > li:before {
                    display: inline-block;
                    content: "-";
                    width: 1em;
                    margin-left: -1em;
                }
            </style>
            <t t-foreach="docs" t-as="doc">
                <div class="header">
                    <t t-set="company" t-value="docs.env.company"/>
                    <div t-if="company" style="text-align: center;">
                        <img t-if="company.logo" class="o_company_logo_big" t-att-src="image_data_uri(company.logo)" style="height: auto; width:85%" alt="Logo"/>
                    </div>
                </div>
                <div class="page" style="page-break-inside: always;">
                    <div class="px-5">
                        <h3 style="text-align: center; font-weight: 700">VENDOR EVALUATION SHEET</h3>
                        <div class="general_information">
                            <div class="row">
                                <div class="col-6">
                                    <span>Request date for evaluation:  </span>
                                    <span t-esc="doc.date_order.strftime('%d %b %Y')" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <div>
                                        <span>PIC: </span>
                                        <span t-field="doc.user_id" />
                                    </div>
                                    <div>
                                        <span>Purpose: </span>
                                        <span class="fw-bold" t-field="doc.notes" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <t t-set="purchase_orders" t-value="doc.rfq_selection_ids.po_id"/>
                    <table class="table table-bordered rfq_comparison">
                        <tr class="fw-bold">
                            <td class="text-center">Description</td>
                            <td class="text-center" t-foreach="range(1, len(purchase_orders) + 1)" t-as="order_index">
                                <span>Vendor <t t-esc="order_index"/></span>
                            </td>
                        </tr>
                        <tr class="fw-bold">
                            <td>Vendor's Name</td>
                            <td class="text-center" t-foreach="purchase_orders" t-as="order">
                                <span t-field="order.partner_id" />
                            </td>
                        </tr>
                        <tr>
                            <td>Address:</td>
                            <td t-foreach="purchase_orders" t-as="order">
                                <span t-esc="order.partner_id._display_address(without_company=True)" />
                            </td>
                        </tr>
                        <tr>
                            <td>Tel/Fax:</td>
                            <td class="text-center" t-foreach="purchase_orders" t-as="order">
                                <span t-field="order.partner_id.phone" />
                            </td>
                        </tr>
                        <tr>
                            <td>Establishment year/capital:</td>
                            <td class="text-center" t-foreach="purchase_orders" t-as="order">
                                <span></span>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <span>The latest project in TLIPC:</span>
                                <ul class="dash" style="margin-bottom: auto">
                                    <li>Value:</li>
                                    <li>Quality:</li>
                                </ul>
                            </td>
                            <td t-foreach="purchase_orders" t-as="order">
                               <ul class="dash" style="margin-bottom: auto">
                                    <li>Value: <t t-esc="order.partner_id.get_latest_purchase_order().amount_untaxed" /></li>
                                    <li>Quality: </li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <span><b>Price </b>(excluded. VAT)</span>
                            </td>
                            <td class="text-center fw-bold" t-foreach="purchase_orders" t-as="order">
                                <span t-field="order.amount_untaxed" />
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Payment Term</td>
                            <td class="text-center" t-foreach="purchase_orders" t-as="order">
                                <p t-esc="order.payment_term_desc" />
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Specification of goods</td>
                            <td class="text-center" t-foreach="purchase_orders" t-as="order">
                                <p t-foreach="order.order_line" t-as="line">
                                    <span t-field="line.product_id" />
                                     __
                                    <span t-field="line.name" />
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Warranty Period</td>
                            <td class="text-center" t-foreach="purchase_orders" t-as="order">
                                <p t-foreach="order.order_line.filtered(lambda l: l.warranty)" t-as="line">
                                    <span t-field="line.product_id" />
                                     __ 
                                    <span t-field="line.warranty" />
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Other Condition</td>
                            <td class="text-center" t-foreach="purchase_orders" t-as="order">
                                <p t-esc="order.other_condition" />
                            </td>
                        </tr>
                    </table>
                    <div class="px-5 fw-bold">
                        <p>Prepared &amp; Proposed by:</p>
                    </div>
                    <table class="table table-bordered">
                        <tr class="fw-bold">
                            <td>PIC/Purchaser</td>
                            <td>Propose to choose the vendor &amp; reason</td>
                        </tr>
                        <tr>
                            <td>
                                <span t-field="doc.user_id" />
                            </td>
                            <td>
                                <ul class="dash mb-2" t-foreach="doc.rfq_selection_ids" t-as="selection">
                                    <li>
                                        <t t-set="vendor_index" t-value="purchase_orders.ids.index(selection.po_id.id) + 1"/>
                                        <span>Proposed Vendor: Vendor <t t-esc="vendor_index"/></span>
                                    </li>
                                    <li>
                                        Reason:
                                        <p t-esc="selection.reason" />
                                    </li>
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <span>Date: <span t-if="doc.approval_request_id" t-esc="doc.approval_request_id.create_date.strftime('%d %b %Y')" /></span>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_vendor_evaluation" model="ir.actions.report">
        <field name="name">Vendor Evaluation Sheet</field>
        <field name="model">procurement.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tlip_procurement.report_vendor_evaluation_form</field>
        <field name="report_file">tlip_procurement.report_vendor_evaluation_form</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
        <field name="binding_type">report</field>
        <field name="binding_model_id" eval="False"/>
        <field name="print_report_name">(object.name)</field>
    </record>

</odoo>
