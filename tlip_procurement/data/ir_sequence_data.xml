<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="request_purchase_sequence" model="ir.sequence">
        <field name="name">Request for Purchase Sequence</field>
        <field name="code">request.purchase</field>
        <field name="prefix">F1-REQ-%(range_year)s%(range_month)s-</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range" eval="True"/>
        <field name="active" eval="True"/>
    </record>

    <record id="procurement_task_sequence" model="ir.sequence">
        <field name="name">Procurement Task Sequence</field>
        <field name="code">procurement.task</field>
        <field name="prefix">F2-PRT-%(range_year)s%(range_month)s-</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range" eval="True"/>
        <field name="active" eval="True"/>
    </record>

    <record id="purchase_supplement_sequence" model="ir.sequence">
        <field name="name">Purchase Supplement Sequence</field>
        <field name="code">purchase.supplement</field>
        <field name="prefix">PS</field>
        <field name="padding">2</field>
        <field name="number_increment">1</field>
        <field name="active" eval="True"/>
    </record>

    <record id="purchase_order_rfq_sequence" model="ir.sequence">
        <field name="name">Purchase Order RFQ Sequence</field>
        <field name="code">purchase.order.rfq</field>
        <field name="prefix">RFQ-%(range_year)s%(range_month)s-</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range" eval="True"/>
        <field name="active" eval="True"/>
    </record>

    <record id="purchase_order_po_sequence" model="ir.sequence">
        <field name="name">Purchase Order PO Sequence</field>
        <field name="code">purchase.order.po</field>
        <field name="prefix">PO-%(range_year)s%(range_month)s-</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range" eval="True"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
