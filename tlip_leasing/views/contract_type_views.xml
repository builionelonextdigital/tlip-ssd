<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="contract_type_view_list" model="ir.ui.view">
        <field name="name">contract_type.view.list</field>
        <field name="model">contract.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="classification" />
                <field name="document_template_id" />
            </list>
        </field>
    </record>
    
    <record model="ir.actions.act_window" id="action_contract_type_view">
        <field name="name">Contract Type</field>
        <field name="res_model">contract.type</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('tlip_leasing.contract_type_view_list')})]" />
    </record>

</odoo>
