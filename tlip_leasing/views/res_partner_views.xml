<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tlip_leasing_customer_tree" model="ir.ui.view">
        <field name="name">tlip.leasing.customer.tree</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="mode">primary</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <field name="user_id" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="company_id" position="after">
                <field name="customer_code" />
                <field name="customer_type_ids" widget="many2many_tags"
                    options="{'no_create': True, 'no_create_edit': True}" />
                <field name="customer_state" widget="badge"
                    decoration-danger="customer_state == 'rejected'"
                    decoration-info="customer_state == 'draft'"
                    decoration-success="customer_state == 'approved'" />
            </field>
        </field>
    </record>

    <record id="view_tlip_leasing_customer_form" model="ir.ui.view">
        <field name="name">tlip.leasing.customer.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="tlip_approval.view_tlip_base_partner_form_inherit_approval" />
        <field name="mode">primary</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">Customers</attribute>
            </xpath>
            <button name="action_update_contact_info" position="before">
                <button name="action_submit_approval" string="Submit" type="object"
                    context="{'approval_partner_type': 'customer'}"
                    class="btn btn-secondary"
                    invisible="customer_state != 'draft'"
                    confirm="Are you sure that you want to do this action?" />
                <button name="action_reset" string="Reset" type="object" class="oe_highlight"
                    confirm="Are you sure that you want to do this action?"
                    context="{'approval_partner_type': 'customer'}"
                    invisible="customer_state != 'rejected'" />
            </button>
            <field name="customer_state" position="after">
                <field name="customer_state" widget="statusbar" statusbar_visible="draft" />
            </field>
            <xpath expr="//group[@name='register_address_vn']/span[@name='address_name']"
                position="before">
                <field name="customer_code" readonly="1" />
            </xpath>
            <xpath expr="//group[@name='register_address_en']/span[@name='address_name']"
                position="before">
                <field name="customer_type_ids" widget="many2many_tags"
                    options="{'no_create': True, 'no_create_edit': True}" required="1"
                    readonly="customer_state != 'draft'" />
            </xpath>
            <xpath expr="//group[@name='detail_company_info']/field[@name='function']"
                position="before">
                <field name="customer_type_ids" widget="many2many_tags"
                    options="{'no_create': True, 'no_create_edit': True}" required="1"
                    readonly="customer_state != 'draft'"/>
            </xpath>
            <button name="action_get_attachment_view" position="after">
                <button class="oe_stat_button"
                    type="object" name="action_view_change_requests_customer"
                    icon="fa-file-text-o"
                    string="Change Requests"
                    invisible="customer_state != 'approved'"
                />
            </button>
        </field>
    </record>

    <record id="tlip_leasing_customer_action" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('tlip_leasing.view_tlip_leasing_customer_tree')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('base.res_partner_kanban_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('tlip_leasing.view_tlip_leasing_customer_form')})]" />
        <field name="search_view_id" ref="tlip_base.view_partner_search_inherit_tlip_base" />
        <field name="domain">[('customer_state', '=', 'approved'), ('parent_id', '=', False)]</field>
        <field name="context">{'default_is_company': True, 'default_customer_rank': 1,
            'leasing_customer': True, 'create': 0}</field>
    </record>

    <record id="tlip_leasing_customer_registration_action" model="ir.actions.act_window">
        <field name="name">Tenant Registration</field>
        <field name="res_model">res.partner</field>
        <field name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('tlip_leasing.view_tlip_leasing_customer_tree')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('base.res_partner_kanban_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('tlip_leasing.view_tlip_leasing_customer_form')})]" />
        <field name="search_view_id" ref="tlip_base.view_partner_search_inherit_tlip_base" />
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="context">{'default_is_company': True, 'default_customer_rank': 1,
            'leasing_customer': True,'create': 0}</field>
    </record>

    <record id="tlip_leasing_customer_type_action" model="ir.actions.act_window">
        <field name="name">Customer Type</field>
        <field name="res_model">res.partner.type</field>
        <field name="view_mode">list</field>
        <field name="domain">[]</field>
    </record>

    <record id="tlip_leasing_register_customer_action" model="ir.actions.act_window">
        <field name="name">Register Customer</field>
        <field name="res_model">check.partner.exist.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_check_type': 'customer'}</field>
    </record>
</odoo>
