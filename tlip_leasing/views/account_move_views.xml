<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_request_payment_form" model="ir.ui.view">
        <field name="name">account.move.form.view.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="tlip_account.account_move_form_view_inherit" />
        <field name="arch" type="xml">
            <field name="invoice_type_id" position="after">
                <!-- Replace with landplot relationship in R1 -->
                <!-- <field name="land_plot_id" readonly="state != 'draft'"
                    invisible="move_type not in ('out_invoice', 'out_refund') or invoice_type_code != 'leasing'"
                    domain="[('is_land_plot', '=', True), ('is_plot_view', '=', False), ('usage', '=', 'internal')]"
                    options="{'no_create': True, 'no_create_edit': True}" /> -->
                <field name="land_plot_name" readonly="state != 'draft'" 
                    invisible="move_type not in ('out_invoice', 'out_refund') or invoice_type_code != 'leasing'"/>
                <field name="deposit_paid_amount" readonly="state != 'draft'"
                    invisible="move_type not in ('out_invoice', 'out_refund') or invoice_type_code != 'leasing'" />
                
            </field>
        </field>
    </record>

    <record id="view_invoice_request_payment_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.view.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="tlip_account.view_invoice_request_payment_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_request_invoice_on_draft" string="Request Invoice"
                    type="object"
                    class="btn btn-primary"
                    invisible="approval_state != 'approved' or state != 'draft' or move_type != 'out_invoice' or parent_move_id or invoice_type_code in ('utility', 'others')" />
            </header>
            <field name="partner_shipping_id" position="after">
                <field name="child_move_ids" invisible="1" />
                <field name="parent_move_id" invisible="1" />
            </field>
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='area']"
                position="attributes">
                <attribute name="readonly">parent.parent_move_id</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='date_from']"
                position="attributes">
                <attribute name="readonly">parent.parent_move_id</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='price_unit']"
                position="attributes">
                <attribute name="readonly">parent.parent_move_id</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='leasing_price_unit']"
                position="attributes">
                <attribute name="readonly">parent.parent_move_id</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='product_uom_id']"
                position="attributes">
                <attribute name="readonly">parent.parent_move_id</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <field name="development_project_id" position="after">
                <field name="completion_minutes_document" required="parent_move_id"
                    invisible="not parent_move_id" readonly="approval_state != 'draft'"
                    force_save="1" />
            </field>
            <field name="development_project_id" position="after">
                <field name="completion_minutes_document" required="parent_move_id"
                    invisible="not parent_move_id" readonly="approval_state != 'draft'"
                    force_save="1" />
            </field>
        </field>
    </record>

    <record id="action_leasing_invoice_payment_request" model="ir.actions.act_window">
        <field name="name">Request for Payment</field>
        <field name="res_model">account.move</field>
        <field name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('tlip_account.view_invoice_request_payment_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('tlip_account.view_invoice_request_payment_form')})]" />
        <field name="domain">[('move_type', '=', 'out_invoice'), ('is_request_payment', '=', True), ('invoice_type_code', '!=', 'utility')]</field>
        <field name="context">{'default_move_type': 'out_invoice',
            'default_is_request_payment':True, 'request_source': 'sale'}</field>
    </record>

</odoo>
