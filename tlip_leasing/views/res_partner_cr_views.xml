<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tlip_leasing_customer_cr_tree" model="ir.ui.view">
        <field name="name">tlip.leasing.customer.cr.tree</field>
        <field name="model">res.partner.cr</field>
        <field name="inherit_id" ref="tlip_base.view_tlip_base_res_partner_cr_tree" />
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="customer_code" />
                <field name="customer_type_ids" widget="many2many_tags"
                    options="{'no_create': True, 'no_create_edit': True}"/>
            </field>
        </field>
    </record>

    <record id="view_tlip_leasing_customer_cr_form" model="ir.ui.view">
        <field name="name">tlip.leasing.customer.cr.form</field>
        <field name="model">res.partner.cr</field>
        <field name="inherit_id"
            ref="tlip_approval.view_tlip_base_res_partner_cr_form_inherit_approval" />
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">Customers</attribute>
            </xpath>
            <xpath expr="//group[@name='register_address_vn']/span[@name='address_name']"
                position="before">
                <field name="customer_code" readonly="1" />
            </xpath>
            <xpath expr="//group[@name='register_address_en']/span[@name='address_name']"
                position="before">
                <field name="customer_type_ids" widget="many2many_tags"
                    options="{'no_create': True, 'no_create_edit': True}" required="1" readonly="state != 'draft'" />
            </xpath>
            <xpath expr="//group[@name='detail_company_info']/field[@name='function']"
                position="before">
                <field name="customer_type_ids" widget="many2many_tags"
                    options="{'no_create': True, 'no_create_edit': True}" required="1" readonly="state != 'draft'" />
            </xpath>
        </field>
    </record>

    <record id="tlip_leasing_customer_cr_action" model="ir.actions.act_window">
        <field name="name">Customer Change Requests</field>
        <field name="res_model">res.partner.cr</field>
        <field name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('tlip_leasing.view_tlip_leasing_customer_cr_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('tlip_leasing.view_tlip_leasing_customer_cr_form')})]" />
        <field name="search_view_id" ref="tlip_base.view_tlip_base_res_partner_cr_search" />
        <field name="domain">[]</field>
        <field name="context">{'create': 0, 'delete': 0}</field>
    </record>
</odoo>