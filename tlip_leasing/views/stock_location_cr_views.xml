<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_location_cr_view_form" model="ir.ui.view">
        <field name="name">stock.location.cr.view.form</field>
        <field name="model">stock.location.cr</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <widget name="attach_document" string="Attach Document" action="message_post"
                        highlight="1" invisible="state != 'draft'"/>
                    <button name="action_submit_approval" string="Submit" type="object"
                        class="btn btn-primary"
                        invisible="state != 'draft'"
                        confirm="Are you sure that you want to do this action?" />
                    <button name="action_complete" string="Complete" type="object"
                        class="btn btn-primary"
                        invisible="state != 'approved'"
                        confirm="Are you sure that you want to do this action?" />
                    <button name="action_withdraw_approval" string="Withdraw" type="object"
                        confirm="Are you sure that you want to do this action?"
                        class="btn btn-secondary"
                        invisible="state not in ('wait_for_approval', 'draft') or user_id != uid" />
                    <button name="action_reset" string="Reset" type="object"
                        confirm="Are you sure that you want to do this action?"
                        class="btn btn-secondary"
                        invisible="state not in ('rejected', 'cancel')" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_open_approval_history_ids"
                            type="object" icon="fa-history">
                            <div class="o_stat_info">
                                <span class="o_stat_text">
                                    Approval Histories
                                </span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">Request</span>
                        <h1 class="d-flex">
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group string="Request Information">
                        <group>
                            <field name="plot_view_id" required="1"
                                options="{'no_create': True}"
                                readonly="state != 'draft'" />
                            <field name="user_id" required="1"
                                options="{'no_create': True}"
                                readonly="state != 'draft'" />
                            <field name="cr_type"
                                widget="radio" options="{'horizontal': true}"
                                readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="create_date" />
                            <field name="effective_date" readonly="state != 'draft'" />
                        </group>
                    </group>
                    <group>
                        <field name="description" readonly="state != 'draft'" />
                    </group>
                    <group string="Merge Information" name="merge_land_plot_group" invisible="cr_type != 'merge'">
                        <field name="merge_land_plot_ids" readonly="state != 'draft'" nolabel="1"
                            colspan="2">
                            <list editable="bottom">
                                <field name="plot_view_id" column_invisible="1" />
                                <field name="available_land_plot_ids" column_invisible="1" />
                                <field name="land_plot_id" options="{'no_create': True}" />
                                <field name="gross_area" />
                                <field name="saleable_area" />
                                <field name="lease_state" />
                                <field name="current_contract_id" />
                                <field name="contract_period_str" />
                            </list>
                        </field>
                        <group string="New Land Plot Information">
                            <field name="new_name"
                                readonly="state != 'draft'"
                                required="cr_type in ('merge')" />
                            <label for="new_date_start" string="Effective Period" />
                            <div class="o_row">
                                <field name="new_date_start"
                                    nolabel="1" class="oe_inline"
                                    readonly="state != 'draft'"
                                    required="cr_type in ('merge')" />
                                <i class="fa fa-long-arrow-right mx-2" aria-label="to" title="to" />
                                <field name="new_date_end"
                                    nolabel="1" class="oe_inline"
                                    readonly="state != 'draft'"
                                    required="cr_type in ('merge')" />
                            </div>
                            <label for="new_gross_area" />
                            <div>
                                <field name="new_gross_area" class="oe_inline" /> m2 </div>
                            <label for="new_saleable_area" />
                            <div>
                                <field name="new_saleable_area" class="oe_inline"
                                    required="cr_type in ('merge')" /> m2 </div>
                            <field name="new_land_plot_category_id"
                                options="{'no_create': True}"
                                required="cr_type in ('merge')"
                                readonly="state != 'draft'" />
                        </group>
                    </group>
                    <group string="Split Information" name="split_land_plot_group" invisible="cr_type != 'split'">
                        <group>
                            <field name="land_plot_id"
                                required="cr_type in ('split')"
                                options="{'no_create': True}"
                                readonly="state != 'draft'" />
                            <field name="original_gross_area" />
                            <field name="original_saleable_area" />
                        </group>
                        <group>
                            <field name="original_lease_state" />
                            <field name="land_plot_contract_id" />
                            <field name="land_plot_contract_period_str" />
                        </group>
                        <group string="New Land Plot Information">
                            <field name="number_to_split"
                            required="cr_type in ('split')"
                            readonly="state != 'draft'"/>
                        </group>
                        <field name="split_land_plot_ids" string="Number of new land plot" readonly="state != 'draft'">
                            <list editable="bottom" create="false" delete="false">
                                <field name="cr_id" column_invisible="1" />
                                <field name="name" />
                                <field name="gross_area" />
                                <field name="saleable_area" />
                                <field name="land_plot_category_id"  options="{'no_create': True}"/>
                                <field name="date_start" />
                                <field name="date_end" />
                            </list>
                        </field>
                    </group>
                    <notebook>
                        <page string="Approver(s)" name="approver"
                            invisible="state in ('draft', 'in_progress', 'canceled')">
                            <field name="approver_ids" mode="list" readonly="1">
                                <list editable="bottom" decoration-success="status=='approved'"
                                    decoration-warning="status in ['pending', 'waiting']"
                                    decoration-danger="status=='refused'" no_open="1">
                                    <field name="existing_request_user_ids" column_invisible="True" />
                                    <field name="sequence" column_invisible="True" />
                                    <field name="user_id" string="Approver"
                                        required="not job_id" />
                                    <field name="job_id" required="not user_id" />
                                    <field name="status" />
                                    <field name="company_id" column_invisible="True" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="stock_location_view_tree" model="ir.ui.view">
        <field name="name">stock.location.view.tree</field>
        <field name="model">stock.location.cr</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="cr_type" />
                <field name="plot_view_id" />
                <field name="state" widget="badge"
                    decoration-danger="state == 'rejected'"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'wait_for_approval'"
                    decoration-success="state == 'approved'" />
            </list>
        </field>
    </record>

    <record id="view_stock_location_cr_filter" model="ir.ui.view">
        <field name="name">stock.location.cr.view.search</field>
        <field name="model">stock.location.cr</field>
        <field name="arch" type="xml">
            <search string="Search Request for Purchasing">
                <field name="name" string="Request" />
                <field name="user_id" />
                <filter name="my_requests" string="My Request " domain="[('user_id', '=', uid)]" />
                <separator />
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]" />
                <separator />
                <filter name="approved" string="Confirmed" domain="[('state', '=', 'approved')]" />
                <filter name="to_approve" string="Waiting for Approval"
                    domain="[('state', '=', 'wait_for_approval')]" />
                <separator />
                <group expand="0" string="Group By">
                    <filter string="Requester" name="requester" domain="[]"
                        context="{'group_by': 'user_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="stock_location_cr_action" model="ir.actions.act_window">
        <field name="name">Change Land Plots</field>
        <field name="res_model">stock.location.cr</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
