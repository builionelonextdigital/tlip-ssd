<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="minvoice_template_view_form" model="ir.ui.view">
        <field name="name">minvoice.template.view.form</field>
        <field name="model">minvoice.template</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="minvoice_type"/>
                            <field name="code" readonly="1"/>
                            <field name="invoice_series" readonly="1"/>
                            <field name="active" readonly="1"/>
                        </group>
                        <group>
                            <field name="payment_method" />
                            <field name="currency_id"
                                options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" />
                            <field name="minvoice_account_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="journal" string="Sổ nhật ký">
                            <field name="journal_ids">
                                <list create="0">
                                    <field name="name" />
                                    <field name="code" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="minvoice_template_view_tree" model="ir.ui.view">
        <field name="name">minvoice.template.view.tree</field>
        <field name="model">minvoice.template</field>
        <field name="arch" type="xml">
            <list string='Mẫu hóa đơn điện tử' create="0" multi_edit="1">
                <field name="code" string="Kí hiệu loại hóa đơn" />
                <field name="invoice_series" />
                <field name="minvoice_type" />
                <field name="minvoice_account_id" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="action_view_minvoice_template" model="ir.actions.act_window">
        <field name="name">Mẫu hóa đơn điện tử</field>
        <field name="view_mode">list,form</field>
        <field name="res_model">minvoice.template</field>
    </record>
</odoo>
