<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form_inherited_minvoice" model="ir.ui.view">
        <field name="name">account.journal.form.inherited.minvoice</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="minvoice_account_id" options="{'no_create': True}" domain="[('toggle_status', '=', True)]" groups="account.group_account_manager"/>
            </field>
        </field>
    </record>

</odoo>
