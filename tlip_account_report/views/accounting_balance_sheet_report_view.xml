<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_accounting_balance_sheet_report_form_inherit_esign" model="ir.ui.view">
        <field name="name">accounting.balance.sheet.report.form.inherit.esign</field>
        <field name="model">accounting.balance.sheet.report</field>
        <field name="inherit_id" ref="biz_accounting_balance_sheet.view_accounting_balance_sheet_report_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_sign_ticket"
                    string="Request E-Sign"
                    type="object"
                    class="btn-primary"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                    name="action_open_sign_ticket"
                    type="object"
                    invisible="not sign_ticket_count">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="sign_ticket_count"/>
                        </span>
                        <span class="o_stat_text">Sign Tickets</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
