<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend sign.ticket form to show report_name and template loader -->
    <record id="view_sign_ticket_form_esign_report" model="ir.ui.view">
        <field name="name">sign.ticket.form.esign.report</field>
        <field name="model">sign.ticket</field>
        <field name="inherit_id" ref="pcv_sign_ticket.view_sign_ticket_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <group>
                    <field name="report_name"
                        invisible="not report_name"
                        placeholder="Auto-filled when created from a report"
                        readonly="1"/>
                </group>
            </xpath>
            <field name="res_id" position="attributes">
                <attribute name="invisible">document_type_id.account_report_id</attribute>
            </field>
        </field>
    </record>

    <record id="view_sign_ticket_list_inherit_tlip" model="ir.ui.view">
        <field name="name">sign.ticket.list.inherit.tlip</field>
        <field name="model">sign.ticket</field>
        <field name="inherit_id" ref="pcv_sign_ticket.view_sign_ticket_list"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="report_name"/>
            </field>
        </field>
    </record>
</odoo>
