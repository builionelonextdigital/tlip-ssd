<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_accounting_balance_sheet_inherit_signer"
        inherit_id="biz_accounting_balance_sheet.report_accounting_balance_sheet">
        <xpath expr="//div[hasclass('table-parameter')]" position="after">
            <div t-if="o.env.context.get('show_signer_placeholders')" class="row text-center" style="page-break-inside:avoid; color: white; margin-top: 100px; margin-bottom: 100px;">
                <div style="page-break-after: avoid;" class="col-4">
                    <p>[signer1]</p>
                </div>
                <div style="page-break-after: avoid;" class="col-4">
                    <p>[signer2]</p>
                </div>
                <div style="page-break-after: avoid;" class="col-4">
                    <p>[signer3]</p>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
